module

public import HodgeConjecture.Boundary.Normalization.NormalClosureTensor
public import HodgeConjecture.CommutativeAlgebra.ReducedArtinianFactor
public import Mathlib.RingTheory.Etale.Field

@[expose] public section

/-!
# The selected generic factor of a marked normal closure

For a separable marked extension the existing tensor source is finite
étale over the base field. Its reduced Artinian decomposition selects the
factor indexed by the actual evaluation kernel. The first projection is
the original evaluation homomorphism, and its complementary kernel ideal
is generated by one minus the uniquely characterized selecting idempotent.
-/

set_option autoImplicit false
set_option maxHeartbeats 800000
set_option synthInstance.maxHeartbeats 100000

namespace HodgeConjecture.CollisionFoundations

noncomputable section

open scoped TensorProduct Classical

universe u

namespace NormalClosureData

variable {K L N : Type u} [Field K] [Field L] [Field N]
variable [Algebra K L] [Algebra K N]

/-- The existing field tensor source is finite-dimensional over its
original base field, without a separability premise. -/
theorem tensorSource_finite (D : NormalClosureData K L N) :
    Module.Finite K (⨂[K] _ : L →ₐ[K] N, L) := by
  letI : FiniteDimensional K L := D.finiteIntermediate
  exact piTensorProduct_finite (L →ₐ[K] N)

/-- Separability of the marked intermediate extension makes its entire
finite tensor source étale over the base field. -/
theorem tensorSource_etale [Algebra.IsSeparable K L]
    (D : NormalClosureData K L N) :
    Algebra.Etale K (⨂[K] _ : L →ₐ[K] N, L) := by
  letI : FiniteDimensional K L := D.finiteIntermediate
  letI : Algebra.FormallyEtale K L := Algebra.FormallyEtale.of_isSeparable K L
  letI : Algebra.FinitePresentation K L := Algebra.FinitePresentation.of_finiteType.mp inferInstance
  letI : Algebra.Etale K L := {}
  exact piTensorProduct_etale (L →ₐ[K] N)

variable [Algebra.IsSeparable K L]

/-- The maximal ideal defined by the actual evaluation selects the
marked normal closure as a factor of the original tensor algebra. -/
def tensorEvaluationProductEquiv (D : NormalClosureData K L N) :
    (⨂[K] _ : L →ₐ[K] N, L) ≃ₐ[K] N ×
      (∀ I : { I : MaximalSpectrum (⨂[K] _ : L →ₐ[K] N, L) //
        I ≠ ⟨RingHom.ker D.tensorEvaluation.toRingHom, D.tensorEvaluation_ker_isMaximal⟩ },
        (⨂[K] _ : L →ₐ[K] N, L) ⧸ I.val.asIdeal) := by
  letI := D.tensorSource_finite
  letI := D.tensorSource_etale
  letI : IsArtinianRing (⨂[K] _ : L →ₐ[K] N, L) := isArtinian_of_tower K inferInstance
  letI : IsReduced (⨂[K] _ : L →ₐ[K] N, L) :=
    Algebra.FormallyUnramified.isReduced_of_field K _
  exact fieldQuotientProductEquiv D.tensorEvaluation D.tensorEvaluation_surjective

/-- The first projection of the selected product decomposition is the
original evaluation, as an equality of algebra homomorphisms. -/
theorem fst_comp_tensorEvaluationProductEquiv (D : NormalClosureData K L N) :
    (AlgHom.fst K N _).comp D.tensorEvaluationProductEquiv.toAlgHom = D.tensorEvaluation := by
  letI := D.tensorSource_finite
  letI := D.tensorSource_etale
  letI : IsArtinianRing (⨂[K] _ : L →ₐ[K] N, L) := isArtinian_of_tower K inferInstance
  letI : IsReduced (⨂[K] _ : L →ₐ[K] N, L) :=
    Algebra.FormallyUnramified.isReduced_of_field K _
  exact fst_comp_fieldQuotientProductEquiv D.tensorEvaluation D.tensorEvaluation_surjective

/-- The selecting idempotent is the inverse image of `(1, 0)` under the
decomposition whose first projection is the actual tensor evaluation. -/
def tensorEvaluationIdempotent (D : NormalClosureData K L N) :
    ⨂[K] _ : L →ₐ[K] N, L :=
  D.tensorEvaluationProductEquiv.symm (1, 0)

/-- The selecting idempotent evaluates to one and annihilates exactly the
evaluation kernel; that kernel is the ideal generated by its complement. -/
theorem tensorEvaluationIdempotent_spec (D : NormalClosureData K L N) :
    IsIdempotentElem D.tensorEvaluationIdempotent ∧
      D.tensorEvaluation D.tensorEvaluationIdempotent = 1 ∧
      (∀ x, D.tensorEvaluationIdempotent * x = 0 ↔ D.tensorEvaluation x = 0) ∧
      RingHom.ker D.tensorEvaluation.toRingHom =
        Ideal.span {1 - D.tensorEvaluationIdempotent} := by
  letI := D.tensorSource_finite
  letI := D.tensorSource_etale
  letI : IsArtinianRing (⨂[K] _ : L →ₐ[K] N, L) := isArtinian_of_tower K inferInstance
  letI : IsReduced (⨂[K] _ : L →ₐ[K] N, L) :=
    Algebra.FormallyUnramified.isReduced_of_field K _
  exact ⟨fieldQuotientIdempotent_isIdempotentElem D.tensorEvaluation D.tensorEvaluation_surjective,
    fieldQuotientIdempotent_map D.tensorEvaluation D.tensorEvaluation_surjective,
    fieldQuotientIdempotent_mul_eq_zero_iff D.tensorEvaluation D.tensorEvaluation_surjective,
    fieldQuotient_ker_eq_span_one_sub D.tensorEvaluation D.tensorEvaluation_surjective⟩

/-- The value one and kernel-annihilation properties determine the
selecting idempotent uniquely; no auxiliary splitting choice remains. -/
theorem tensorEvaluationIdempotent_unique (D : NormalClosureData K L N)
    (e : ⨂[K] _ : L →ₐ[K] N, L) (he : D.tensorEvaluation e = 1)
    (hker : ∀ x, D.tensorEvaluation x = 0 → e * x = 0) :
    e = D.tensorEvaluationIdempotent := by
  letI := D.tensorSource_finite
  letI := D.tensorSource_etale
  letI : IsArtinianRing (⨂[K] _ : L →ₐ[K] N, L) := isArtinian_of_tower K inferInstance
  letI : IsReduced (⨂[K] _ : L →ₐ[K] N, L) :=
    Algebra.FormallyUnramified.isReduced_of_field K _
  exact fieldQuotientIdempotent_unique D.tensorEvaluation D.tensorEvaluation_surjective e he hker

end NormalClosureData

end

end HodgeConjecture.CollisionFoundations
