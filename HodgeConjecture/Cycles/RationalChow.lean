import HodgeConjecture.Cycles.CoefficientExtension
import HodgeConjecture.Cycles.PrincipalRelations
import HodgeConjecture.Cycles.ScalarExtensionQuotient

/-!
# Rational coefficients on the actual principal-relation quotient

The rational relation submodule is generated by coefficient extensions
of the existing actual ambient principal divisors. Tensoring the integral
Chow quotient with `ℚ` gives exactly this quotient of rational homogeneous
cycles, with the same representatives and class maps.
-/

set_option autoImplicit false

namespace HodgeConjecture.SchemeCycles

open AlgebraicGeometry TensorProduct

noncomputable section

universe u

variable {X : Scheme.{u}}

/-- The rational span of the same actual integer principal generators. -/
def rationalPrincipalRelations [IsNoetherian X] (δ : DimensionFunction X) (n : ℤ) :
    Submodule ℚ (cyclesOfDegree ℚ δ n) :=
  Submodule.span ℚ (Set.range (fun d ↦
    cyclesOfDegreeRationalize δ n (principalRelation δ n d)))

/-- Rational homogeneous cycles modulo the actual principal relations. -/
abbrev RationalChowGroup [IsNoetherian X] (δ : DimensionFunction X) (n : ℤ) :=
  (cyclesOfDegree ℚ δ n) ⧸ rationalPrincipalRelations δ n

/-- The quotient class of an actual rational homogeneous cycle. -/
def rationalClassMap [IsNoetherian X] (δ : DimensionFunction X) (n : ℤ) :
    cyclesOfDegree ℚ δ n →ₗ[ℚ] RationalChowGroup δ n :=
  (rationalPrincipalRelations δ n).mkQ

theorem rationalClassMap_eq_zero_iff [IsNoetherian X] (δ : DimensionFunction X) (n : ℤ)
    (c : cyclesOfDegree ℚ δ n) :
    rationalClassMap δ n c = 0 ↔ c ∈ rationalPrincipalRelations δ n :=
  Submodule.Quotient.mk_eq_zero (rationalPrincipalRelations δ n)

/-- Every rational class has an actual finite homogeneous cycle representative. -/
theorem rationalClassMap_surjective [IsNoetherian X] (δ : DimensionFunction X) (n : ℤ) :
    Function.Surjective (rationalClassMap δ n) :=
  (rationalPrincipalRelations δ n).mkQ_surjective

@[simp]
theorem rationalClassMap_principalRelation [IsNoetherian X]
    (δ : DimensionFunction X) (n : ℤ) (d : PrincipalRelationData δ n) :
    rationalClassMap δ n (cyclesOfDegreeRationalize δ n (principalRelation δ n d)) = 0 :=
  (rationalClassMap_eq_zero_iff δ n _).mpr (Submodule.subset_span (Set.mem_range_self d))

/-- Scalar extension of the existing integral Chow quotient is the quotient
of rational cycles by the rational span of its actual principal divisors. -/
def chowRationalizationEquiv [IsNoetherian X] (δ : DimensionFunction X) (n : ℤ) :
    (ℚ ⊗[ℤ] ChowGroup δ n) ≃ₗ[ℚ] RationalChowGroup δ n :=
  scalarExtensionQuotientEquiv (principalRelation δ n) (cyclesOfDegreeRationalize δ n)
    (cyclesOfDegreeRationalizationEquiv δ n) (cyclesOfDegreeRationalizationEquiv_tmul δ n)

@[simp]
theorem chowRationalizationEquiv_tmul_classMap [IsNoetherian X]
    (δ : DimensionFunction X) (n : ℤ) (q : ℚ) (c : cyclesOfDegree ℤ δ n) :
    chowRationalizationEquiv δ n (q ⊗ₜ[ℤ] classMap δ n c) =
      rationalClassMap δ n (q • cyclesOfDegreeRationalize δ n c) := rfl

/-- Integral Chow classes have a canonical rationalization map. -/
def chowRationalize [IsNoetherian X] (δ : DimensionFunction X) (n : ℤ) :
    ChowGroup δ n →ₗ[ℤ] RationalChowGroup δ n :=
  ((chowRationalizationEquiv δ n).toLinearMap.restrictScalars ℤ).comp
    (TensorProduct.mk ℤ ℚ (ChowGroup δ n) 1)

@[simp]
theorem chowRationalize_classMap [IsNoetherian X]
    (δ : DimensionFunction X) (n : ℤ) (c : cyclesOfDegree ℤ δ n) :
    chowRationalize δ n (classMap δ n c) =
      rationalClassMap δ n (cyclesOfDegreeRationalize δ n c) := by
  change chowRationalizationEquiv δ n (1 ⊗ₜ[ℤ] classMap δ n c) = _
  simp

/-- The absence of actual carriers above generic degree also makes the
rational relation span zero. -/
theorem rationalPrincipalRelations_genericDegree_eq_bot
    (X : Scheme.{u}) [IsIntegral X] [IsNoetherian X] (δ : DimensionFunction X) :
    rationalPrincipalRelations δ (δ (genericPoint X)) = ⊥ := by
  letI := isEmpty_principalRelationData_genericDegree X δ
  simp only [rationalPrincipalRelations, Set.range_eq_empty, Submodule.span_empty]

end

end HodgeConjecture.SchemeCycles
