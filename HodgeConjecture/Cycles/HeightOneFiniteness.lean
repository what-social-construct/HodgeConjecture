module

public import Mathlib.RingTheory.Ideal.Height
public import Mathlib.RingTheory.Ideal.MinimalPrime.Noetherian

@[expose] public section

/-!
# Height-one primes meeting a nonzero principal ideal

In a domain, a height-one prime containing a nonzero element is minimal
over its principal ideal: the nonzero ideal has positive height, leaving
no room for a smaller prime above it. In a Noetherian domain, finiteness
of minimal primes therefore gives finiteness of these height-one primes.

The ambient ring may have arbitrary Krull dimension. No normality,
discrete valuation ring, or dimension-at-most-one assumption is used.
-/

set_option autoImplicit false

namespace HodgeConjecture.SchemeCycles

variable {A : Type*} [CommRing A] [IsDomain A]

/-- A height-one prime containing a nonzero element is minimal over the
actual principal ideal generated by that element. -/
theorem heightOne_mem_minimalPrimes_span (a : A) (ha : a ≠ 0)
    (P : Ideal A) [P.IsPrime] (hP : P.height = 1) (haP : a ∈ P) :
    P ∈ (Ideal.span {a}).minimalPrimes := by
  have hspan : Ideal.span {a} ≠ (⊥ : Ideal A) := by
    intro h
    have : a ∈ (⊥ : Ideal A) := h ▸ Ideal.subset_span (Set.mem_singleton a)
    exact ha (by simpa using this)
  letI : (⊥ : Ideal A).FiniteHeight := ⟨Or.inr (by simp)⟩
  letI : (⊥ : Ideal A).IsPrime := inferInstance
  letI : P.FiniteHeight := ⟨Or.inr (by simp [hP])⟩
  apply Ideal.mem_minimalPrimes_of_height_eq
    ((Ideal.span_singleton_le_iff_mem P).mpr haP)
  rw [hP]
  apply Order.one_le_iff_pos.mpr
  simpa using Ideal.height_strict_mono_of_isPrime (bot_lt_iff_ne_bot.mpr hspan)

/-- There are finitely many height-one prime ideals containing a given
nonzero element of a Noetherian domain. -/
theorem finite_heightOne_ideals_containing [IsNoetherianRing A]
    (a : A) (ha : a ≠ 0) :
    Set.Finite {P : Ideal A | P.IsPrime ∧ P.height = 1 ∧ a ∈ P} := by
  refine (Ideal.finite_minimalPrimes_of_isNoetherianRing A (Ideal.span {a})).subset ?_
  rintro P ⟨hprime, hheight, hmem⟩
  letI : P.IsPrime := hprime
  exact heightOne_mem_minimalPrimes_span a ha P hheight hmem

/-- The prime-spectrum form of the height-one finiteness bound, without
any restriction on the dimension of the ambient Noetherian domain. -/
theorem finite_heightOne_primes_containing (A : Type*)
    [CommRing A] [IsDomain A] [IsNoetherianRing A] (a : A) (ha : a ≠ 0) :
    Set.Finite {p : PrimeSpectrum A | p.asIdeal.height = 1 ∧ a ∈ p.asIdeal} := by
  have hinj : Function.Injective (PrimeSpectrum.asIdeal (R := A)) :=
    @PrimeSpectrum.ext A _
  refine ((finite_heightOne_ideals_containing a ha).preimage hinj.injOn).subset ?_
  intro p hp
  exact ⟨p.isPrime, hp⟩

/-- The height-one loci of a nonzero numerator and denominator have finite
union. This is the support bound before constructing a principal divisor. -/
theorem finite_heightOne_primes_containing_either (A : Type*)
    [CommRing A] [IsDomain A] [IsNoetherianRing A]
    (a b : A) (ha : a ≠ 0) (hb : b ≠ 0) :
    Set.Finite {p : PrimeSpectrum A |
      p.asIdeal.height = 1 ∧ (a ∈ p.asIdeal ∨ b ∈ p.asIdeal)} := by
  refine ((finite_heightOne_primes_containing A a ha).union
    (finite_heightOne_primes_containing A b hb)).subset ?_
  rintro p ⟨hheight, haP | hbP⟩
  · exact Or.inl ⟨hheight, haP⟩
  · exact Or.inr ⟨hheight, hbP⟩

end HodgeConjecture.SchemeCycles
