module

public import Mathlib.LinearAlgebra.Finsupp.LinearCombination
public import Mathlib.LinearAlgebra.Quotient.Basic
public import Mathlib.Algebra.GroupWithZero.Units.Basic

@[expose] public section

/-!
# Degree-two Milnor symbols with coefficients

This is the usual generators-and-relations module on pairs of units:
multiplication is additive in either entry, and `{u,v}=0` if `u+v=1`.
The coefficient ring is explicit. No identification with Bloch's higher
Chow groups is assumed or asserted. The logarithmic realization is built
separately from the actual de Rham differential.
-/

set_option autoImplicit false

namespace HodgeConjecture.MilnorSymbols

noncomputable section

universe u v

variable (k : Type u) (A : Type v) [CommRing k] [CommRing A]

/-- Finite linear combinations of ordered pairs of actual units. -/
abbrev FreeSymbols := (Aˣ × Aˣ) →₀ k

/-- The multiplicativity and Steinberg relations in degree two. -/
inductive Relation : FreeSymbols k A → Prop
  | mul_left (u v w : Aˣ) : Relation
      (Finsupp.single (u * v, w) 1 - Finsupp.single (u, w) 1 - Finsupp.single (v, w) 1)
  | mul_right (u v w : Aˣ) : Relation
      (Finsupp.single (u, v * w) 1 - Finsupp.single (u, v) 1 - Finsupp.single (u, w) 1)
  | steinberg (u v : Aˣ) (h : (u : A) + (v : A) = 1) : Relation (Finsupp.single (u, v) 1)

/-- The actual relation span, rather than a supplied kernel condition. -/
def relations : Submodule k (FreeSymbols k A) :=
  Submodule.span k {r | Relation k A r}

/-- Degree-two Milnor symbols with the indicated coefficient ring. -/
abbrev K2 := FreeSymbols k A ⧸ relations k A

/-- An ordered Milnor symbol, in the actual presented quotient. -/
def symbol (u v : Aˣ) : K2 k A :=
  (relations k A).mkQ (Finsupp.single (u, v) 1)

theorem relation_class_zero (r : FreeSymbols k A) (hr : Relation k A r) :
    (relations k A).mkQ r = 0 :=
  (Submodule.Quotient.mk_eq_zero _).mpr (Submodule.subset_span hr)

@[simp]
theorem symbol_mul_left (u v w : Aˣ) :
    symbol k A (u * v) w = symbol k A u w + symbol k A v w := by
  have h := relation_class_zero k A _ (Relation.mul_left u v w)
  rw [map_sub, map_sub, sub_sub, sub_eq_zero] at h
  exact h

@[simp]
theorem symbol_mul_right (u v w : Aˣ) :
    symbol k A u (v * w) = symbol k A u v + symbol k A u w := by
  have h := relation_class_zero k A _ (Relation.mul_right u v w)
  rw [map_sub, map_sub, sub_sub, sub_eq_zero] at h
  exact h

theorem symbol_steinberg (u v : Aˣ) (h : (u : A) + (v : A) = 1) :
    symbol k A u v = 0 :=
  relation_class_zero k A _ (Relation.steinberg u v h)

@[simp]
theorem symbol_one_left (u : Aˣ) : symbol k A 1 u = 0 := by
  have h := symbol_mul_left k A 1 1 u
  simp only [one_mul] at h
  exact add_left_cancel (show symbol k A 1 u + symbol k A 1 u = symbol k A 1 u + 0 by
    simpa only [add_zero] using h.symm)

@[simp]
theorem symbol_one_right (u : Aˣ) : symbol k A u 1 = 0 := by
  have h := symbol_mul_right k A u 1 1
  simp only [one_mul] at h
  exact add_left_cancel (show symbol k A u 1 + symbol k A u 1 = symbol k A u 1 + 0 by
    simpa only [add_zero] using h.symm)

@[simp]
theorem symbol_inv_left (u v : Aˣ) : symbol k A u⁻¹ v = -symbol k A u v := by
  have h := symbol_mul_left k A u u⁻¹ v
  rw [mul_inv_cancel, symbol_one_left] at h
  exact eq_neg_of_add_eq_zero_left (by simpa only [add_comm] using h.symm)

@[simp]
theorem symbol_inv_right (u v : Aˣ) : symbol k A u v⁻¹ = -symbol k A u v := by
  have h := symbol_mul_right k A u v v⁻¹
  rw [mul_inv_cancel, symbol_one_right] at h
  exact eq_neg_of_add_eq_zero_left (by simpa only [add_comm] using h.symm)

/-- The quotient is generated by the original unit symbols. -/
theorem span_symbols : Submodule.span k (Set.range (Function.uncurry (symbol k A))) = ⊤ := by
  apply top_unique
  intro z hz
  clear hz
  obtain ⟨f, rfl⟩ := (relations k A).mkQ_surjective z
  induction f using Finsupp.induction with
  | zero => simp
  | @single_add x a f _ _ ih =>
      rw [map_add]
      apply Submodule.add_mem _ _ ih
      have h : (relations k A).mkQ (Finsupp.single x a) = a • symbol k A x.1 x.2 := by
        rw [symbol, ← map_smul]
        congr 1
        simp
      rw [h]
      exact Submodule.smul_mem _ a (Submodule.subset_span ⟨x, rfl⟩)

end

end HodgeConjecture.MilnorSymbols
