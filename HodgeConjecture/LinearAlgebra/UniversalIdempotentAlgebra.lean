import Mathlib.Algebra.Algebra.Prod
import Mathlib.RingTheory.Idempotents

/-!
# The universal algebra of one idempotent

The product algebra `R × R` carries the distinguished idempotent `(1, 0)`.
Every idempotent `e` in an associative `R`-algebra determines a canonical
algebra homomorphism

`R × R →ₐ[R] B`,  `(r, s) ↦ r • e + s • (1 - e)`.

The target algebra need not be commutative.  Only the two-dimensional image
generated by `e` and `1 - e` is commutative.  This small universal source is
useful when two constructions specify the same projector role without
supplying an algebra homomorphism between their larger ambient algebras.
-/

set_option autoImplicit false

namespace HodgeConjecture

noncomputable section

universe u v w

/-- The universal `R`-algebra carrying one distinguished idempotent. -/
abbrev UniversalIdempotentAlgebra (R : Type u) := R × R

namespace UniversalIdempotentAlgebra

variable {R : Type u} [CommRing R]

/-- The distinguished idempotent of `R × R`. -/
def selector : UniversalIdempotentAlgebra R := (1, 0)

/-- The complementary distinguished idempotent of `R × R`. -/
def complement : UniversalIdempotentAlgebra R := (0, 1)

@[simp]
theorem selector_isIdempotent :
    IsIdempotentElem (selector (R := R)) := by
  simp [IsIdempotentElem, selector]

@[simp]
theorem complement_isIdempotent :
    IsIdempotentElem (complement (R := R)) := by
  simp [IsIdempotentElem, complement]

@[simp]
theorem selector_add_complement :
    selector (R := R) + complement = 1 := by
  simp [selector, complement]

@[simp]
theorem selector_mul_complement :
    selector (R := R) * complement = 0 := by
  simp [selector, complement]

@[simp]
theorem complement_mul_selector :
    complement (R := R) * selector = 0 := by
  simp [selector, complement]

variable {B : Type v} [Ring B] [Algebra R B]

/--
The canonical algebra homomorphism from the universal one-idempotent algebra
to an associative algebra containing a chosen idempotent.

No centrality hypothesis on `e` is required.
-/
def mapOfIdempotent (e : B) (he : IsIdempotentElem e) :
    UniversalIdempotentAlgebra R →ₐ[R] B where
  toFun z := z.1 • e + z.2 • (1 - e)
  map_one' := by
    simp
  map_mul' x y := by
    rcases x with ⟨a, b⟩
    rcases y with ⟨c, d⟩
    dsimp
    have hec : IsIdempotentElem (1 - e) := he.one_sub
    have hecRight : e * (1 - e) = 0 := by
      rw [mul_sub, mul_one, he.eq, sub_self]
    have hecLeft : (1 - e) * e = 0 := by
      rw [sub_mul, one_mul, he.eq, sub_self]
    rw [mul_add, add_mul, add_mul]
    simp only [smul_mul_smul, he.eq, hec.eq, hecRight, hecLeft,
      smul_zero, add_zero, zero_add]
  map_zero' := by
    simp
  map_add' x y := by
    simp only [Prod.fst_add, Prod.snd_add, add_smul]
    abel
  commutes' r := by
    change r • e + r • (1 - e) = algebraMap R B r
    rw [← smul_add]
    simp [Algebra.smul_def]

@[simp]
theorem mapOfIdempotent_apply
    (e : B) (he : IsIdempotentElem e)
    (z : UniversalIdempotentAlgebra R) :
    mapOfIdempotent e he z =
      z.1 • e + z.2 • (1 - e) :=
  rfl

@[simp]
theorem mapOfIdempotent_selector
    (e : B) (he : IsIdempotentElem e) :
    mapOfIdempotent e he (selector (R := R)) = e := by
  simp [mapOfIdempotent, selector]

@[simp]
theorem mapOfIdempotent_complement
    (e : B) (he : IsIdempotentElem e) :
    mapOfIdempotent e he (complement (R := R)) = 1 - e := by
  simp [mapOfIdempotent, complement]

@[simp]
theorem mapOfIdempotent_one
    (e : B) (he : IsIdempotentElem e) :
    mapOfIdempotent (R := R) e he 1 = 1 :=
  map_one (mapOfIdempotent (R := R) e he)

variable {C : Type w} [Ring C] [Algebra R C]

/-- The universal map is natural under algebra homomorphisms. -/
theorem comp_mapOfIdempotent
    (f : B →ₐ[R] C)
    (e : B) (he : IsIdempotentElem e) :
    f.comp (mapOfIdempotent e he) =
      mapOfIdempotent (f e) (he.map f) := by
  apply AlgHom.ext
  rintro ⟨a, b⟩
  simp [mapOfIdempotent]

end UniversalIdempotentAlgebra

end

end HodgeConjecture
