import HodgeConjecture.CompactificationProjector
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Chow-style correspondence quotients and projectors

Mathlib does not yet provide a general construction of algebraic cycles
modulo rational equivalence.  This file isolates exactly that missing
geometric input while proving the algebraic consequences.

A `ChowCorrespondenceRealization` contains:

* a commutative ring of raw correspondence cycles;
* an ideal representing rational equivalence;
* the class of a scheme-theoretic selector in the quotient;
* an action of raw cycles on cohomology;
* a proof that rationally trivial cycles act by zero.

The raw action therefore descends canonically to the quotient.  Idempotent
selectors give idempotent Chow classes and cohomological projectors.

The commutative raw cycle ring should be understood as the commutative
subalgebra generated by the selector classes needed here.  A future
noncommutative Chow-correspondence library can replace this interface without
changing the projector arguments.
-/

set_option autoImplicit false

namespace HodgeConjecture

noncomputable section

universe u v w z t b

/--
A presentation of the part of a Chow-correspondence algebra generated by
scheme-theoretic selectors, together with its cohomological action.
-/
structure ChowCorrespondenceRealization
    (C : Type u) (Z : Type v) (K : Type w) (V : Type z)
    [CommRing C] [CommRing Z] [CommRing K]
    [AddCommGroup V] [Module K V] where
  rationalEquivalence : Ideal Z
  selectorClass : C →+* (Z ⧸ rationalEquivalence)
  rawCycleAction : Z →+* Module.End K V
  rationalEquivalence_acts_trivially :
    ∀ cycle : Z,
      cycle ∈ rationalEquivalence →
        rawCycleAction cycle = 0

namespace ChowCorrespondenceRealization

variable {C : Type u} {Z : Type v} {K : Type w} {V : Type z}
variable [CommRing C] [CommRing Z] [CommRing K]
variable [AddCommGroup V] [Module K V]

/--
The cohomological action descended from raw cycles to cycles modulo rational
equivalence.
-/
def chowAction
    (ρ : ChowCorrespondenceRealization C Z K V) :
    (Z ⧸ ρ.rationalEquivalence) →+* Module.End K V :=
  Ideal.Quotient.lift
    ρ.rationalEquivalence
    ρ.rawCycleAction
    ρ.rationalEquivalence_acts_trivially

/-- The descended action agrees with the raw action on cycle representatives. -/
@[simp]
theorem chowAction_mk
    (ρ : ChowCorrespondenceRealization C Z K V)
    (cycle : Z) :
    ρ.chowAction
        (Ideal.Quotient.mk ρ.rationalEquivalence cycle) =
      ρ.rawCycleAction cycle :=
  Ideal.Quotient.lift_mk
    ρ.rationalEquivalence
    ρ.rawCycleAction
    ρ.rationalEquivalence_acts_trivially

/--
Rationally equivalent raw cycles induce the same cohomological
endomorphism.
-/
theorem rawCycleAction_eq_of_sub_mem_rationalEquivalence
    (ρ : ChowCorrespondenceRealization C Z K V)
    {cycle₁ cycle₂ : Z}
    (hRational :
      cycle₁ - cycle₂ ∈ ρ.rationalEquivalence) :
    ρ.rawCycleAction cycle₁ =
      ρ.rawCycleAction cycle₂ := by
  have hZero :
      ρ.rawCycleAction (cycle₁ - cycle₂) = 0 :=
    ρ.rationalEquivalence_acts_trivially
      (cycle₁ - cycle₂) hRational
  rw [map_sub, sub_eq_zero] at hZero
  exact hZero

/--
The Chow presentation supplies the abstract correspondence realization used
by the projector layer.
-/
def toCorrespondenceRealization
    (ρ : ChowCorrespondenceRealization C Z K V) :
    CorrespondenceRealization
      C (Z ⧸ ρ.rationalEquivalence) K V where
  schemeToCorrespondence := ρ.selectorClass
  action := ρ.chowAction

/-- An idempotent selector has an idempotent class modulo rational equivalence. -/
theorem selectorClass_isIdempotent
    (ρ : ChowCorrespondenceRealization C Z K V)
    {q : C} (hq : IsIdempotentElem q) :
    IsIdempotentElem (ρ.selectorClass q) :=
  hq.map ρ.selectorClass

/-- An idempotent selector defines a realized Chow projector. -/
theorem isRealizedChowProjector
    (ρ : ChowCorrespondenceRealization C Z K V)
    {q : C} (hq : IsIdempotentElem q) :
    ρ.toCorrespondenceRealization.IsRealizedProjector q :=
  ρ.toCorrespondenceRealization.isRealizedProjector hq

end ChowCorrespondenceRealization

/--
A Chow-style realization whose raw cycle action preserves every piece of a
chosen grading.
-/
structure BigradedChowCorrespondenceRealization
    (C : Type u) (Z : Type v) (K : Type w) (V : Type z)
    (ι : Type t)
    [CommRing C] [CommRing Z] [CommRing K]
    [AddCommGroup V] [Module K V]
    extends ChowCorrespondenceRealization C Z K V where
  piece : ι → Submodule K V
  rawCycleAction_preserves_piece :
    ∀ (cycle : Z) (i : ι) (x : V),
      x ∈ piece i →
        rawCycleAction cycle x ∈ piece i

/--
The `(p,q)`-indexed specialization used for Hodge-compatible cycle
projectors.
-/
abbrev HodgeChowCorrespondenceRealization
    (C : Type u) (Z : Type v) (K : Type w) (V : Type z)
    [CommRing C] [CommRing Z] [CommRing K]
    [AddCommGroup V] [Module K V] :=
  BigradedChowCorrespondenceRealization C Z K V (ℤ × ℤ)

namespace BigradedChowCorrespondenceRealization

variable {C : Type u} {Z : Type v} {K : Type w} {V : Type z}
variable {ι : Type t}
variable [CommRing C] [CommRing Z] [CommRing K]
variable [AddCommGroup V] [Module K V]

/--
The descended Chow action preserves the grading because the raw cycle action
does.
-/
def toBigradedCorrespondenceRealization
    (ρ : BigradedChowCorrespondenceRealization C Z K V ι) :
    BigradedCorrespondenceRealization
      C (Z ⧸ ρ.rationalEquivalence) K V ι where
  toCorrespondenceRealization :=
    ρ.toChowCorrespondenceRealization.toCorrespondenceRealization
  piece := ρ.piece
  action_preserves_piece := by
    intro cycleClass i x hx
    refine Quotient.inductionOn' cycleClass ?_
    intro cycle
    simpa [
      ChowCorrespondenceRealization.toCorrespondenceRealization
    ] using
      ρ.rawCycleAction_preserves_piece cycle i x hx

/-- An idempotent selector gives a Chow projector splitting every graded piece. -/
theorem isBigradedChowProjector
    (ρ : BigradedChowCorrespondenceRealization C Z K V ι)
    {q : C} (hq : IsIdempotentElem q) :
    ρ.toBigradedCorrespondenceRealization.IsBigradedRealizedProjector q :=
  ρ.toBigradedCorrespondenceRealization.isBigradedRealizedProjector hq

end BigradedChowCorrespondenceRealization

section Compactification

attribute [local instance] FractionRing.liftAlgebra
  FractionRing.isScalarTower_liftAlgebra

variable (R S : Type u)
variable [CommRing R] [CommRing S] [Algebra R S]
variable [IsDedekindDomain R] [IsDedekindDomain S]
variable [NoZeroSMulDivisors R S] [Module.Finite R S]
variable [Algebra.IsSeparable (FractionRing R) (FractionRing S)]

variable (G : Type v) [Group G]
variable (β : Type b)
variable (I : β → Subgroup G)
variable (D : Subgroup G)
variable (P : β → Ideal S)
variable [∀ i : β, (P i).IsPrime]

variable {C : Type w} {Z : Type z} {K : Type*} {V : Type*}
variable [CommRing C] [CommRing Z] [CommRing K]
variable [AddCommGroup V] [Module K V]

/--
Compactified Chow-projector criterion: a global selector class modulo rational
equivalence acts as a cohomological projector exactly when the collision
different avoids every boundary prime.
-/
theorem exists_compactification_chowProjector_iff_forall_different_not_le
    (hDifferent : CollisionDifferentComparison R S)
    (hInertia :
      ∀ i : β,
        HeightOneInertiaRealization R S G (I i) D (P i))
    (E : CompactificationSelectorExtension C G β I D)
    (ρ : ChowCorrespondenceRealization C Z K V) :
    (∃ e : E.Extension,
      ρ.toCorrespondenceRealization.IsRealizedProjector
        (E.selector e)) ↔
      ∀ i : β, ¬ collisionNoetherDifferentIdeal R S ≤ P i :=
  exists_compactification_realizedProjector_iff_forall_different_not_le
    R S G β I D P hDifferent hInertia E
      ρ.toCorrespondenceRealization

variable {ι : Type*}

/--
Hodge-style compactified Chow-projector criterion.  The resulting projector
preserves and splits every chosen bigraded piece.
-/
theorem exists_compactification_bigradedChowProjector_iff_forall_different_not_le
    (hDifferent : CollisionDifferentComparison R S)
    (hInertia :
      ∀ i : β,
        HeightOneInertiaRealization R S G (I i) D (P i))
    (E : CompactificationSelectorExtension C G β I D)
    (ρ : BigradedChowCorrespondenceRealization C Z K V ι) :
    (∃ e : E.Extension,
      ρ.toBigradedCorrespondenceRealization.IsBigradedRealizedProjector
        (E.selector e)) ↔
      ∀ i : β, ¬ collisionNoetherDifferentIdeal R S ≤ P i :=
  exists_compactification_bigradedProjector_iff_forall_different_not_le
    R S G β I D P hDifferent hInertia E
      ρ.toBigradedCorrespondenceRealization

end Compactification

end

end HodgeConjecture
