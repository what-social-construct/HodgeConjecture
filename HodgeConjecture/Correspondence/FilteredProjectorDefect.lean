module

public import HodgeConjecture.Correspondence.ProjectorDefect
public import Mathlib.Algebra.Polynomial.Module.AEval
public import Mathlib.Algebra.Module.FinitePresentation
public import Mathlib.RingTheory.Polynomial.Basic
public import Mathlib.RingTheory.FilteredAlgebra.Basic
public import Mathlib.FieldTheory.Finiteness

@[expose] public section

/-!
# The cyclic filtered module of an existing projector defect

For an element `q` of the original (possibly noncommutative) rational
algebra, use the native polynomial action `X • z = q * z`. The cyclic
submodule generated by the existing defect `q*q-q` retains equality in
that original algebra. Its degree filtration is the image of the native
polynomial degree filtration under its canonical cyclic presentation.

Thus stage `n` is spanned by `d, q*d, ..., q^n*d`, where `d = q*q-q`.
The module is finitely presented over `ℚ[X]`, each filtration stage is
finite over `ℚ`, and the filtration is exhaustive and compatible with
polynomial degree. It is zero exactly when the original defect is zero.

This is an algebraic degree filtration. No Hodge filtration, connection,
mixed Hodge module, geometric flatness or vanishing is asserted.
-/

set_option autoImplicit false

noncomputable section

namespace HodgeConjecture.ProjectorDefectModule

open Polynomial

universe u v

variable {A : Type u} [Ring A] [Algebra ℚ A] (q : A)

/-- The native polynomial action by left multiplication with `q`. -/
abbrev Ambient := Module.AEval ℚ A q

/-- The cyclic submodule of the original algebra generated by its actual defect. -/
def submodule : Submodule ℚ[X] (Ambient q) :=
  Submodule.span ℚ[X] {Module.AEval.of ℚ A q (projectorIdempotenceDefect q)}

/-- The existing cyclic submodule, with its native module structures. -/
abbrev Carrier := submodule q

/-- The distinguished element is the original defect, not its cohomology class. -/
def generator : Carrier q :=
  ⟨Module.AEval.of ℚ A q (projectorIdempotenceDefect q),
    Submodule.subset_span (Set.mem_singleton _)⟩

/-- Inclusion into the original correspondence algebra, forgetting only the action alias. -/
def embedding : Carrier q →ₗ[ℚ] A :=
  (Module.AEval.of ℚ A q).symm.toLinearMap.comp
    ((submodule q).subtype.restrictScalars ℚ)

theorem embedding_injective : Function.Injective (embedding q) :=
  (Module.AEval.of ℚ A q).symm.injective.comp Subtype.val_injective

@[simp]
theorem embedding_generator : embedding q (generator q) = projectorIdempotenceDefect q := rfl

/-- The canonical cyclic presentation by a free rank-one polynomial module. -/
def presentation : ℚ[X] →ₗ[ℚ[X]] Carrier q :=
  LinearMap.toSpanSingleton ℚ[X] (Carrier q) (generator q)

@[simp]
theorem presentation_apply (p : ℚ[X]) : presentation q p = p • generator q := rfl

@[simp]
theorem presentation_one : presentation q 1 = generator q := by simp

theorem presentation_surjective : Function.Surjective (presentation q) := by
  intro z
  obtain ⟨p, hp⟩ := Submodule.mem_span_singleton.mp z.property
  exact ⟨p, Subtype.ext hp⟩

@[simp]
theorem embedding_presentation (p : ℚ[X]) :
    embedding q (presentation q p) = aeval q p * projectorIdempotenceDefect q := rfl

@[simp]
theorem embedding_X_pow (n : ℕ) :
    embedding q (presentation q (X ^ n)) = q ^ n * projectorIdempotenceDefect q := by
  rw [embedding_presentation, aeval_X_pow]

instance finite : Module.Finite ℚ[X] (Carrier q) :=
  Module.Finite.of_fg (Submodule.fg_span_singleton _)

instance finitePresentation : Module.FinitePresentation ℚ[X] (Carrier q) :=
  Module.finitePresentation_of_finite ℚ[X] (Carrier q)

/-- No realization kernel is discarded: triviality detects actual idempotence. -/
theorem subsingleton_iff_defect_eq_zero :
    Subsingleton (Carrier q) ↔ projectorIdempotenceDefect q = 0 := by
  change Subsingleton (submodule q) ↔ _
  rw [Submodule.subsingleton_iff_eq_bot]
  change Submodule.span ℚ[X] {Module.AEval.of ℚ A q (projectorIdempotenceDefect q)} = ⊥ ↔ _
  rw [Submodule.span_singleton_eq_bot]
  exact (Module.AEval.of ℚ A q).map_eq_zero_iff

theorem subsingleton_iff_isIdempotent :
    Subsingleton (Carrier q) ↔ IsIdempotentElem q :=
  (subsingleton_iff_defect_eq_zero q).trans (projectorIdempotenceDefect_eq_zero_iff q)

/-- The actual relations are precisely polynomials whose evaluation kills the defect. -/
theorem mem_annihilator_iff (p : ℚ[X]) :
    p ∈ Module.annihilator ℚ[X] (Carrier q) ↔
      aeval q p * projectorIdempotenceDefect q = 0 := by
  change p ∈ (Submodule.span ℚ[X]
    {Module.AEval.of ℚ A q (projectorIdempotenceDefect q)}).annihilator ↔ _
  rw [Submodule.mem_annihilator_span_singleton]
  change Module.AEval.of ℚ A q (aeval q p * projectorIdempotenceDefect q) = 0 ↔ _
  exact (Module.AEval.of ℚ A q).map_eq_zero_iff

/-- The native annihilator is the exact relation submodule of the cyclic presentation. -/
theorem presentation_ker :
    LinearMap.ker (presentation q) =
      Module.annihilator ℚ[X] (Carrier q) := by
  ext p
  change presentation q p = 0 ↔ p ∈ Module.annihilator ℚ[X] (Carrier q)
  rw [mem_annihilator_iff, ← embedding_presentation]
  constructor
  · intro h
    simp [h]
  · intro h
    apply embedding_injective q
    simpa using h

/-- The quotient degree filtration induced from the canonical cyclic presentation. -/
def filtration (n : ℕ) : Submodule ℚ (Carrier q) :=
  (Polynomial.degreeLE ℚ n).map ((presentation q).restrictScalars ℚ)

theorem mem_filtration (n : ℕ) (z : Carrier q) :
    z ∈ filtration q n ↔ ∃ p : ℚ[X], p.degree ≤ n ∧ presentation q p = z := by
  simp only [filtration, Submodule.mem_map, Polynomial.mem_degreeLE,
    LinearMap.restrictScalars_apply]

theorem filtration_monotone : Monotone (filtration q) := by
  intro m n h
  exact Submodule.map_mono (Polynomial.degreeLE_mono (WithBot.coe_le_coe.mpr h))

/-- A finite list of powers of the same closure generates each stage. -/
theorem filtration_eq_span (n : ℕ) :
    filtration q n = Submodule.span ℚ
      ((fun i : ℕ ↦ presentation q (X ^ i)) '' (↑(Finset.range (n + 1)) : Set ℕ)) := by
  rw [filtration, Polynomial.degreeLE_eq_span_X_pow, Submodule.map_span]
  simp only [Finset.coe_image, Set.image_image, LinearMap.restrictScalars_apply]

theorem filtration_fg (n : ℕ) : (filtration q n).FG := by
  rw [filtration_eq_span]
  exact Submodule.fg_span ((Finset.finite_toSet _).image _)

instance filtration_finite (n : ℕ) : Module.Finite ℚ (filtration q n) :=
  Module.Finite.of_fg (filtration_fg q n)

theorem generator_mem_filtration_zero : generator q ∈ filtration q 0 := by
  exact (mem_filtration q 0 _).mpr ⟨1, by simp, presentation_one q⟩

theorem filtration_zero : filtration q 0 = Submodule.span ℚ {generator q} := by
  rw [filtration_eq_span]
  simp

theorem filtration_exhaustive : (⨆ n : ℕ, filtration q n) = ⊤ := by
  apply top_unique
  intro z _
  obtain ⟨p, rfl⟩ := presentation_surjective q z
  exact le_iSup (filtration q) p.natDegree
    ((mem_filtration q _ _).mpr ⟨p, Polynomial.degree_le_natDegree, rfl⟩)

/-- Multiplication of polynomial coefficients respects the quotient filtration. -/
theorem smul_mem_filtration {m n : ℕ} {p : ℚ[X]} (hp : p.degree ≤ m)
    {z : Carrier q} (hz : z ∈ filtration q n) : p • z ∈ filtration q (m + n) := by
  obtain ⟨r, hr, rfl⟩ := (mem_filtration q n z).mp hz
  refine (mem_filtration q (m + n) _).mpr ⟨p * r, ?_, ?_⟩
  · exact (Polynomial.degree_mul_le p r).trans (by simpa using add_le_add hp hr)
  · exact (presentation q).map_smul p r

/-- The native polynomial degree filtration is a ring filtration. -/
instance polynomialDegreeFiltration :
    IsRingFiltration (fun n : ℕ ↦ Polynomial.degreeLE ℚ n)
      (fun n ↦ ⨆ k < n, Polynomial.degreeLE ℚ k) where
  mono := fun _ _ h ↦ Polynomial.degreeLE_mono (WithBot.coe_le_coe.mpr h)
  is_le := fun {i j} h ↦ le_iSup_of_le i (le_iSup_of_le h le_rfl)
  is_sup := fun _ _ h ↦ iSup_le (fun i ↦ iSup_le (h i))
  one_mem := Polynomial.mem_degreeLE.mpr (by simp)
  mul_mem := by
    intro m n p r hp hr
    apply Polynomial.mem_degreeLE.mpr
    exact (Polynomial.degree_mul_le p r).trans
      (by simpa using add_le_add (Polynomial.mem_degreeLE.mp hp) (Polynomial.mem_degreeLE.mp hr))

/-- The constructed filtration uses the native filtered-module interface. -/
instance isModuleFiltration :
    IsModuleFiltration (fun n : ℕ ↦ Polynomial.degreeLE ℚ n)
      (fun n ↦ ⨆ k < n, Polynomial.degreeLE ℚ k)
      (filtration q) (fun n ↦ ⨆ k < n, filtration q k) where
  mono := filtration_monotone q
  is_le := fun {i j} h ↦ le_iSup_of_le i (le_iSup_of_le h le_rfl)
  is_sup := fun _ _ h ↦ iSup_le (fun i ↦ iSup_le (h i))
  smul_mem := by
    intro m n p z hp hz
    exact smul_mem_filtration q (Polynomial.mem_degreeLE.mp hp) hz

/-- Every stage, including the degree-zero detector, is zero exactly at idempotence. -/
theorem filtration_eq_bot_iff (n : ℕ) :
    filtration q n = ⊥ ↔ projectorIdempotenceDefect q = 0 := by
  constructor
  · intro h
    have hg : generator q ∈ filtration q n :=
      filtration_monotone q (Nat.zero_le n) (generator_mem_filtration_zero q)
    rw [h, Submodule.mem_bot] at hg
    simpa using congrArg (embedding q) hg
  · intro h
    let := (subsingleton_iff_defect_eq_zero q).mpr h
    exact Subsingleton.elim _ _

end HodgeConjecture.ProjectorDefectModule
