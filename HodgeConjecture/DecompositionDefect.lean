import HodgeConjecture.Collision
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Decomposition defects

Let `J` be an ideal of a commutative ring `C`.  The intended geometric
application is

`C = 𝒪(X ×_Y X)` and `J = I_Δ / I_R`.

The annihilator `ann(J)` defines the canonical residual off-diagonal piece.
Two ideals measure the failure of `J` and `ann(J)` to give a product
decomposition:

* `overlapDefectIdeal J = J ⊓ ann(J)` is the infinitesimal overlap;
* `contactIdeal J = J ⊔ ann(J)` cuts out the contact quotient.

The overlap is square-zero.  Both defects vanish exactly in the clopen
idempotent situation.
-/

set_option autoImplicit false

namespace HodgeConjecture

noncomputable section

universe u

variable {C : Type u} [CommRing C]

/-- The infinitesimal overlap between an ideal and its annihilator. -/
def overlapDefectIdeal (J : Ideal C) : Ideal C :=
  J ⊓ J.annihilator

/-- The sum whose quotient is the diagonal/off-diagonal contact algebra. -/
def contactIdeal (J : Ideal C) : Ideal C :=
  J ⊔ J.annihilator

/-- The quotient supported where the diagonal and residual pieces meet. -/
abbrev ContactRing (J : Ideal C) :=
  C ⧸ contactIdeal J

/-- Elements of the overlap defect multiply to zero. -/
theorem overlapDefectIdeal_mul_eq_zero
    (J : Ideal C) {x y : C}
    (hx : x ∈ overlapDefectIdeal J)
    (hy : y ∈ overlapDefectIdeal J) :
    x * y = 0 := by
  exact
    Submodule.mem_annihilator.mp hx.2 y hy.1

/-- The overlap defect is a square-zero ideal. -/
theorem overlapDefectIdeal_sq_eq_bot (J : Ideal C) :
    overlapDefectIdeal J * overlapDefectIdeal J = ⊥ := by
  apply le_antisymm
  · calc
      overlapDefectIdeal J * overlapDefectIdeal J
          ≤ J.annihilator * J :=
        Ideal.mul_mono inf_le_right inf_le_left
      _ = ⊥ := Submodule.annihilator_mul J
  · exact bot_le

/-- Vanishing overlap is the ideal-theoretic union condition. -/
theorem overlapDefectIdeal_eq_bot_iff (J : Ideal C) :
    overlapDefectIdeal J = ⊥ ↔
      J ⊓ J.annihilator = ⊥ :=
  Iff.rfl

/-- Vanishing contact is the comaximality/disjointness condition. -/
theorem contactIdeal_eq_top_iff (J : Ideal C) :
    contactIdeal J = ⊤ ↔
      J ⊔ J.annihilator = ⊤ :=
  Iff.rfl

/--
Complementary ideal and annihilator defects produce an idempotent generator.
-/
theorem exists_idempotent_generator_of_contact_eq_top
    (J : Ideal C)
    (hContact : contactIdeal J = ⊤) :
    ∃ q : C, IsIdempotentElem q ∧ J = Ideal.span {q} := by
  rw [contactIdeal, Ideal.eq_top_iff_one] at hContact
  obtain ⟨j, hj, a, ha, hja⟩ :=
    Submodule.mem_sup.mp hContact
  have hja_zero : j * a = 0 :=
    by
      simpa [smul_eq_mul, mul_comm] using
        (Submodule.mem_annihilator.mp ha j hj)
  have hj_idem : IsIdempotentElem j := by
    show j * j = j
    calc
      j * j = j * j + j * a := by rw [hja_zero, add_zero]
      _ = j * (j + a) := (mul_add j j a).symm
      _ = j := by rw [hja, mul_one]
  refine ⟨j, hj_idem, ?_⟩
  apply le_antisymm
  · intro x hx
    rw [Ideal.mem_span_singleton']
    refine ⟨x, ?_⟩
    have hxa : x * a = 0 := by
      simpa [smul_eq_mul, mul_comm] using
        (Submodule.mem_annihilator.mp ha x hx)
    calc
      x * j = x * j + x * a := by
        rw [hxa, add_zero]
      _ = x * (j + a) := by rw [mul_add]
      _ = x := by rw [hja, mul_one]
  · exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hj)

/-- An idempotent-generated ideal has no overlap with its annihilator. -/
theorem overlapDefectIdeal_eq_bot_of_idempotent_generator
    (J : Ideal C) (q : C)
    (hq : IsIdempotentElem q)
    (hJ : J = Ideal.span {q}) :
    overlapDefectIdeal J = ⊥ := by
  rw [overlapDefectIdeal, hJ,
    CollisionFoundations.annihilator_span_idempotent hq,
    CollisionFoundations.span_idempotent_inf_span_one_sub_eq_bot hq]

/-- An idempotent-generated ideal is comaximal with its annihilator. -/
theorem contactIdeal_eq_top_of_idempotent_generator
    (J : Ideal C) (q : C)
    (hq : IsIdempotentElem q)
    (hJ : J = Ideal.span {q}) :
    contactIdeal J = ⊤ := by
  rw [contactIdeal, hJ,
    CollisionFoundations.annihilator_span_idempotent hq,
    CollisionFoundations.span_idempotent_sup_span_one_sub_eq_top]

/--
The two decomposition defects vanish exactly when the ideal is generated by
an idempotent.
-/
theorem defects_vanish_iff_exists_idempotent_generator (J : Ideal C) :
    overlapDefectIdeal J = ⊥ ∧ contactIdeal J = ⊤ ↔
      ∃ q : C, IsIdempotentElem q ∧ J = Ideal.span {q} := by
  constructor
  · rintro ⟨_, hContact⟩
    exact
      exists_idempotent_generator_of_contact_eq_top
        J hContact
  · rintro ⟨q, hq, hJ⟩
    exact
      ⟨overlapDefectIdeal_eq_bot_of_idempotent_generator J q hq hJ,
        contactIdeal_eq_top_of_idempotent_generator J q hq hJ⟩

/-- Collision-specific overlap defect. -/
abbrev collisionOverlapDefectIdeal
    (B : Type*) (A : Type*) [CommRing B] [CommRing A] [Algebra B A] :
    Ideal (CollisionAlgebra B A) :=
  overlapDefectIdeal (collisionObstructionIdeal B A)

/-- Collision-specific contact quotient. -/
abbrev CollisionContactRing
    (B : Type*) (A : Type*) [CommRing B] [CommRing A] [Algebra B A] :=
  ContactRing (collisionObstructionIdeal B A)

end

end HodgeConjecture
