module

public import Mathlib.Algebra.Algebra.Pi
public import Mathlib.Algebra.Algebra.Prod
public import Mathlib.RingTheory.Artinian.Module

@[expose] public section

/-!
# The factor selected by a field quotient

A surjective algebra map from a reduced Artinian algebra to a field selects
one factor of its product decomposition. The selected idempotent acts as the
identity on that factor and annihilates exactly the evaluation kernel.
-/

set_option autoImplicit false

namespace HodgeConjecture.CollisionFoundations

noncomputable section

universe uK uP uN uI uA

def piSplitAtAlgEquiv
    {K : Type uK} [CommRing K] {ι : Type uI}
    (A : ι → Type uA) [∀ i, CommRing (A i)] [∀ i, Algebra K (A i)]
    [DecidableEq ι] (i : ι) :
    (∀ j, A j) ≃ₐ[K] A i × (∀ j : {j // j ≠ i}, A j.val) where
  toEquiv := Equiv.piSplitAt i A
  map_mul' _ _ := rfl
  map_add' _ _ := rfl
  commutes' _ := rfl

variable {K : Type uK} {P : Type uP} {N : Type uN}
variable [CommRing K] [CommRing P] [Field N]
variable [Algebra K P] [Algebra K N] [IsArtinianRing P] [IsReduced P]

/-- A field quotient is a specified direct factor of a reduced Artinian algebra. -/
def fieldQuotientProductEquiv (f : P →ₐ[K] N) (hf : Function.Surjective f) :
    P ≃ₐ[K] N ×
      (∀ I : { I : MaximalSpectrum P //
        I ≠ ⟨RingHom.ker f.toRingHom,
          RingHom.ker_isMaximal_of_surjective f.toRingHom hf⟩ }, P ⧸ I.val.asIdeal) := by
  classical
  let m : MaximalSpectrum P :=
    ⟨RingHom.ker f.toRingHom, RingHom.ker_isMaximal_of_surjective f.toRingHom hf⟩
  let e : P ≃ₐ[K] ∀ I : MaximalSpectrum P, P ⧸ I.asIdeal :=
    { __ := IsArtinianRing.equivPi P, commutes' := fun _ => rfl }
  exact (e.trans (piSplitAtAlgEquiv (fun I : MaximalSpectrum P => P ⧸ I.asIdeal) m)).trans
    (AlgEquiv.prodCongr (Ideal.quotientKerAlgEquivOfSurjective hf) (AlgEquiv.refl))

/-- The first component of the decomposition is the given field map. -/
@[simp]
theorem fieldQuotientProductEquiv_fst
    (f : P →ₐ[K] N) (hf : Function.Surjective f) (x : P) :
    (fieldQuotientProductEquiv f hf x).1 = f x := rfl

/-- The product decomposition commutes with the original quotient homomorphism. -/
theorem fst_comp_fieldQuotientProductEquiv
    (f : P →ₐ[K] N) (hf : Function.Surjective f) :
    (AlgHom.fst K N _).comp (fieldQuotientProductEquiv f hf).toAlgHom = f := by
  ext x
  exact fieldQuotientProductEquiv_fst f hf x

/-- The idempotent selecting the factor of the specified field quotient. -/
def fieldQuotientIdempotent (f : P →ₐ[K] N) (hf : Function.Surjective f) : P :=
  (fieldQuotientProductEquiv f hf).symm (1, 0)

/-- The selected factor element is idempotent. -/
theorem fieldQuotientIdempotent_isIdempotentElem
    (f : P →ₐ[K] N) (hf : Function.Surjective f) :
    IsIdempotentElem (fieldQuotientIdempotent f hf) := by
  have he : fieldQuotientProductEquiv f hf (fieldQuotientIdempotent f hf) = (1, 0) :=
    (fieldQuotientProductEquiv f hf).apply_symm_apply (1, 0)
  apply (fieldQuotientProductEquiv f hf).injective
  rw [map_mul, he]
  simp

/-- The selected idempotent has value one in the field quotient. -/
@[simp]
theorem fieldQuotientIdempotent_map
    (f : P →ₐ[K] N) (hf : Function.Surjective f) :
    f (fieldQuotientIdempotent f hf) = 1 := by
  have he : fieldQuotientProductEquiv f hf (fieldQuotientIdempotent f hf) = (1, 0) :=
    (fieldQuotientProductEquiv f hf).apply_symm_apply (1, 0)
  rw [← fieldQuotientProductEquiv_fst f hf]
  exact congrArg Prod.fst he

/-- Multiplication by the selected idempotent annihilates exactly the kernel. -/
theorem fieldQuotientIdempotent_mul_eq_zero_iff
    (f : P →ₐ[K] N) (hf : Function.Surjective f) (x : P) :
    fieldQuotientIdempotent f hf * x = 0 ↔ f x = 0 := by
  have he : fieldQuotientProductEquiv f hf (fieldQuotientIdempotent f hf) = (1, 0) :=
    (fieldQuotientProductEquiv f hf).apply_symm_apply (1, 0)
  rw [← (fieldQuotientProductEquiv f hf).injective.eq_iff]
  rw [map_mul, he, map_zero]
  simpa only [Prod.ext_iff, Prod.fst_mul, Prod.snd_mul, Prod.fst_zero, Prod.snd_zero,
    one_mul, zero_mul, and_true] using
    (show (fieldQuotientProductEquiv f hf x).1 = 0 ↔ f x = 0 by rfl)

/-- Value one and annihilation of the kernel characterize the selected idempotent. -/
theorem fieldQuotientIdempotent_unique
    (f : P →ₐ[K] N) (hf : Function.Surjective f) (e : P)
    (he : f e = 1) (hker : ∀ x : P, f x = 0 → e * x = 0) :
    e = fieldQuotientIdempotent f hf := by
  let q := fieldQuotientIdempotent f hf
  have hq : f (1 - q) = 0 := by simp [q]
  have hmul : e * q = q := by
    have hz := (fieldQuotientIdempotent_mul_eq_zero_iff f hf (e - 1)).mpr
      (by simp [he])
    have hqmul : q * (e - 1) = 0 := hz
    rw [mul_sub, mul_one, sub_eq_zero] at hqmul
    simpa [mul_comm] using hqmul
  have hz := hker (1 - q) hq
  rw [mul_sub, mul_one, hmul, sub_eq_zero] at hz
  exact hz

/-- The evaluation kernel is generated by the complementary idempotent. -/
theorem fieldQuotient_ker_eq_span_one_sub
    (f : P →ₐ[K] N) (hf : Function.Surjective f) :
    RingHom.ker f.toRingHom = Ideal.span {1 - fieldQuotientIdempotent f hf} := by
  apply le_antisymm
  · intro x hx
    have hx0 : f x = 0 := hx
    have he : fieldQuotientIdempotent f hf * x = 0 :=
      (fieldQuotientIdempotent_mul_eq_zero_iff f hf x).mpr hx0
    have hxmul : x = (1 - fieldQuotientIdempotent f hf) * x := by
      rw [sub_mul, one_mul, he, sub_zero]
    rw [hxmul]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span (by simp))
  · apply Ideal.span_le.mpr
    intro x hx
    have hx' : x = 1 - fieldQuotientIdempotent f hf := by simpa using hx
    subst x
    change f (1 - fieldQuotientIdempotent f hf) = 0
    simp

end

end HodgeConjecture.CollisionFoundations
