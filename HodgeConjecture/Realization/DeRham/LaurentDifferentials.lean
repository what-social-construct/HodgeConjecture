module

public import HodgeConjecture.Realization.DeRham.LaurentResidue
public import Mathlib.LinearAlgebra.ExteriorPower.Basic
public import Mathlib.RingTheory.Kaehler.Polynomial

@[expose] public section

/-!
# Actual differential forms of the multiplicative line

The universal Kähler module of `k[T,T⁻¹]` over `k` is freely generated by
the actual form `T⁻¹ dT`. The forward coordinate map is the universal lift
of the Euler derivation, with both inverse identities proved on the
original Kähler module. All exterior powers of degree at least two vanish.

The integer-power differential calculation is selectively adapted from
AxiomMath/Stacks, revision `f8e70c5dd04bfabcb423d5e325461f527c85a5d6`,
`StacksFrontier/RingTheory/DeRham/LaurentHomotopy.lean`, Apache-2.0.
See `third_party/axiom-stacks/LICENSE`.
-/

set_option autoImplicit false

namespace HodgeConjecture.LaurentDeRham

open KaehlerDifferential LaurentPolynomial

noncomputable section

universe u

variable (k : Type u) [CommRing k]

theorem T_smul_T_smul (m n : ℤ) (ω : Ω[LaurentPolynomial k⁄k]) :
    (T m : LaurentPolynomial k) • (T n : LaurentPolynomial k) • ω =
      (T (m + n) : LaurentPolynomial k) • ω := by
  rw [smul_smul, ← T_add]

@[simp]
theorem T_smul_dlogT :
    (T 1 : LaurentPolynomial k) • dlogT k = D k (LaurentPolynomial k) (T 1) := by
  rw [dlogT, T_smul_T_smul]
  norm_num

theorem D_T_neg_one : D k (LaurentPolynomial k) (T (-1)) =
    -((T (-1) : LaurentPolynomial k) • dlogT k) := by
  have h : (T (-1) : LaurentPolynomial k) * T 1 = 1 := by rw [← T_add]; norm_num
  rw [(D k (LaurentPolynomial k)).leibniz_of_mul_eq_one h, ← T_smul_dlogT,
    T_pow, neg_smul, T_smul_T_smul]
  norm_num

/-- Every integer Laurent power has its actual logarithmic differential formula. -/
theorem D_T (n : ℤ) : D k (LaurentPolynomial k) (T n) =
    n • ((T n : LaurentPolynomial k) • dlogT k) := by
  induction n using Int.induction_on with
  | zero => simp
  | succ i hi =>
    have h1 : (T ((i : ℤ) + 1) : LaurentPolynomial k) = T i * T 1 := T_add _ _
    calc
      _ = (T i : LaurentPolynomial k) • D k (LaurentPolynomial k) (T 1) +
          (T 1 : LaurentPolynomial k) • D k (LaurentPolynomial k) (T i) := by
        rw [h1, Derivation.leibniz]
      _ = _ := by
        rw [hi, ← T_smul_dlogT, T_smul_T_smul, smul_comm (T 1 : LaurentPolynomial k),
          T_smul_T_smul, add_comm (1 : ℤ) (i : ℤ), add_smul, one_smul]
        exact add_comm _ _
  | pred i hi =>
    have h2 : (T (-(i : ℤ) - 1) : LaurentPolynomial k) = T (-i) * T (-1) := T_sub _ _
    calc
      _ = (T (-i) : LaurentPolynomial k) • D k (LaurentPolynomial k) (T (-1)) +
          (T (-1) : LaurentPolynomial k) • D k (LaurentPolynomial k) (T (-i)) := by
        rw [h2, Derivation.leibniz]
      _ = _ := by
        rw [hi, D_T_neg_one, smul_neg, T_smul_T_smul,
          smul_comm (T (-1) : LaurentPolynomial k), T_smul_T_smul,
          add_comm (-1 : ℤ) (-(i : ℤ)), ← sub_eq_add_neg, sub_smul, one_smul]
        exact neg_add_eq_sub _ _

/-- Euler coordinates describe every actual universal differential. -/
theorem D_eq_euler_smul_dlogT (f : LaurentPolynomial k) :
    D k (LaurentPolynomial k) f = eulerDerivation k f • dlogT k := by
  induction f using LaurentPolynomial.induction_on' with
  | add f g hf hg => rw [map_add, map_add, add_smul, hf, hg]
  | C_mul_T n a =>
    have hc : D k (LaurentPolynomial k) (C a) = 0 :=
      (D k (LaurentPolynomial k)).map_algebraMap a
    have he : eulerDerivation k (C a * T n) = n • (C a * T n) := by
      rw [← single_eq_C_mul_T, eulerDerivation_single]
    rw [Derivation.leibniz, hc, smul_zero, add_zero, D_T, he,
      smul_comm (C a : LaurentPolynomial k), smul_smul, smul_assoc]

@[simp]
theorem eulerLift_dlogT :
    (eulerDerivation k).liftKaehlerDifferential (dlogT k) = 1 := by
  rw [dlogT, map_smul, Derivation.liftKaehlerDifferential_comp_D, eulerDerivation_T,
    one_zsmul, smul_eq_mul, ← T_add]
  norm_num

/-- Every actual Kähler differential is its Euler coefficient times `dlog T`. -/
theorem eulerLift_smul_dlogT (ω : Ω[LaurentPolynomial k⁄k]) :
    (eulerDerivation k).liftKaehlerDifferential ω • dlogT k = ω := by
  have hω : ω ∈ Submodule.span (LaurentPolynomial k)
      (Set.range (D k (LaurentPolynomial k))) := by
    rw [span_range_derivation]
    exact Submodule.mem_top
  induction hω using Submodule.span_induction with
  | mem ω hω =>
    obtain ⟨f, rfl⟩ := hω
    rw [Derivation.liftKaehlerDifferential_comp_D]
    exact (D_eq_euler_smul_dlogT k f).symm
  | zero => rw [map_zero, zero_smul]
  | add ω η _ _ hω hη => rw [map_add, add_smul, hω, hη]
  | smul a ω _ hω => rw [map_smul, smul_eq_mul, mul_smul, hω]

/-- A proved coordinate equivalence on the original universal Kähler module. -/
def kaehlerCoordinates : Ω[LaurentPolynomial k⁄k] ≃ₗ[LaurentPolynomial k] LaurentPolynomial k where
  __ := (eulerDerivation k).liftKaehlerDifferential
  invFun a := a • dlogT k
  left_inv := eulerLift_smul_dlogT k
  right_inv a := by
    change (eulerDerivation k).liftKaehlerDifferential (a • dlogT k) = a
    rw [map_smul, eulerLift_dlogT, smul_eq_mul, mul_one]

@[simp]
theorem kaehlerCoordinates_symm (a : LaurentPolynomial k) :
    (kaehlerCoordinates k).symm a = a • dlogT k := rfl

theorem span_dlogT : Submodule.span (LaurentPolynomial k)
    (Set.range fun _ : Unit ↦ dlogT k) = ⊤ := by
  apply Submodule.eq_top_iff'.mpr
  intro ω
  rw [← eulerLift_smul_dlogT k ω]
  exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨(), rfl⟩)

/-- A curve's actual exterior form modules vanish in every degree at least two. -/
theorem laurentForms_subsingleton (n : ℕ) (hn : 2 ≤ n) :
    Subsingleton (⋀[LaurentPolynomial k]^n Ω[LaurentPolynomial k⁄k]) :=
  exteriorPower.subsingleton_of_span_eq_top_of_card_lt
    (fun _ : Unit ↦ dlogT k) (span_dlogT k) n (by
      have hcard : Nat.card Unit = 1 := by simp
      rw [hcard]
      omega)

instance laurentTwoForms_subsingleton :
    Subsingleton (⋀[LaurentPolynomial k]^2 Ω[LaurentPolynomial k⁄k]) :=
  laurentForms_subsingleton k 2 (by decide)

/-- Polynomial-chart form modules also vanish from degree two, in their original carriers. -/
theorem polynomialForms_subsingleton (n : ℕ) (hn : 2 ≤ n) :
    Subsingleton (⋀[Polynomial k]^n Ω[Polynomial k⁄k]) := by
  have hspan : Submodule.span (Polynomial k)
      (Set.range fun _ : Unit ↦ D k (Polynomial k) Polynomial.X) = ⊤ := by
    apply Submodule.eq_top_iff'.mpr
    intro ω
    have hω : ω = polynomialEquiv k ω • D k (Polynomial k) Polynomial.X :=
      ((polynomialEquiv k).symm_apply_apply ω).symm
    rw [hω]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨(), rfl⟩)
  exact exteriorPower.subsingleton_of_span_eq_top_of_card_lt
    (fun _ : Unit ↦ D k (Polynomial k) Polynomial.X) hspan n (by
      have hcard : Nat.card Unit = 1 := by simp
      rw [hcard]
      omega)

instance polynomialTwoForms_subsingleton :
    Subsingleton (⋀[Polynomial k]^2 Ω[Polynomial k⁄k]) :=
  polynomialForms_subsingleton k 2 (by decide)

end

end HodgeConjecture.LaurentDeRham
