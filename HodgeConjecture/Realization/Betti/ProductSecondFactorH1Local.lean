module

public import HodgeConjecture.Realization.Betti.ProductSecondFactorCover
public import HodgeConjecture.Realization.Betti.ProductContractibleFactor

/-!
# First cohomology of an affine second-factor chart

When `W` is contractible, projection from `X × W` to `X` is a homotopy
equivalence. The original chart subtype of `X × Y` is homeomorphic to this
product, so its rational singular H¹ is generated by the pullback of any
generator of H¹(X). This supplies the two local chart hypotheses for the
product Mayer–Vietoris H¹ criterion.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace HodgeConjecture.ProductSecondFactorH1Local

open CategoryTheory ContinuousMap ProductSecondFactorCover

variable (X Y : Type) [TopologicalSpace X] [TopologicalSpace Y]

/-- Projection to the first factor when the second factor is contractible. -/
def firstProjectionHomotopyEquiv (W : Type) [TopologicalSpace W]
    [ContractibleSpace W] : (X × W) ≃ₕ X := by
  let e : W ≃ₕ Unit := Classical.choice (ContractibleSpace.hequiv_unit W)
  exact ((ContinuousMap.HomotopyEquiv.refl X).prodCongr e).trans
    (Homeomorph.prodUnique X Unit).toHomotopyEquiv

@[simp] theorem firstProjectionHomotopyEquiv_apply
    (W : Type) [TopologicalSpace W] [ContractibleSpace W] (p : X × W) :
    firstProjectionHomotopyEquiv X W p = p.1 := rfl

/-- Actual singular-cohomology isomorphism induced by first projection. -/
def firstProjectionIso (W : Type) [TopologicalSpace W] [ContractibleSpace W]
    (n : ℕ) :
    SingularCochains.Cohomology (TopCat.of X) n ≅
      SingularCochains.Cohomology (TopCat.of (X × W)) n :=
  SingularHomotopy.homotopyEquivIso (firstProjectionHomotopyEquiv X W) n

theorem firstProjectionIso_hom (W : Type) [TopologicalSpace W]
    [ContractibleSpace W] (n : ℕ) :
    (firstProjectionIso X W n).hom =
      SingularCochains.cohomologyPullback
        (TopCat.ofHom (⟨Prod.fst, continuous_fst⟩ : C(X × W, X))) n := by
  change SingularCochains.cohomologyPullback
    (TopCat.ofHom (firstProjectionHomotopyEquiv X W).toFun) n = _
  congr 1

/-- Projection from the original product-chart subtype to its first factor. -/
def chartProjection (W : Set Y) :
    TopCat.of ↥(chart (X := X) W) ⟶ TopCat.of X :=
  TopCat.ofHom ⟨fun p => p.val.1,
    continuous_fst.comp continuous_subtype_val⟩

/-- The chart H¹ is canonically the first factor's H¹. -/
def chartH1Iso (W : Set Y) [ContractibleSpace W] :
    SingularCochains.Cohomology (TopCat.of X) 1 ≅
      SingularCochains.Cohomology (TopCat.of ↥(chart (X := X) W)) 1 :=
  firstProjectionIso X W 1 ≪≫
    SingularHomotopy.homeomorphIso (chartHomeomorph (X := X) W) 1

/-- Its forward map is pullback along the original chart projection. -/
theorem chartH1Iso_hom (W : Set Y) [ContractibleSpace W] :
    (chartH1Iso X Y W).hom =
      SingularCochains.cohomologyPullback (chartProjection X Y W) 1 := by
  let e := chartHomeomorph (X := X) W
  let p : C(X × W, X) := ⟨Prod.fst, continuous_fst⟩
  have hmap :
      TopCat.ofHom e.toHomotopyEquiv.toFun ≫ TopCat.ofHom p =
      chartProjection X Y W := by
    ext z : 1
    rfl
  have h := congrArg
    (fun f : TopCat.of ↥(chart (X := X) W) ⟶ TopCat.of X =>
      SingularCochains.cohomologyPullback f 1) hmap
  rw [SingularCochains.cohomologyPullback_comp] at h
  change (firstProjectionIso X W 1).hom ≫
    (SingularHomotopy.homeomorphIso e 1).hom =
      SingularCochains.cohomologyPullback (chartProjection X Y W) 1
  rw [firstProjectionIso_hom]
  simpa only [SingularHomotopy.homeomorphIso,
    SingularHomotopy.homotopyEquivIso, e, p] using h

/-- Any first-factor H¹ generator generates the original chart H¹ after
projection pullback. -/
theorem chartH1_generated (W : Set Y) [ContractibleSpace W]
    (ξ : SingularCochains.Cohomology (TopCat.of X) 1)
    (hξ : ∀ z : SingularCochains.Cohomology (TopCat.of X) 1,
      ∃ a : ℚ, z = a • ξ)
    (z : SingularCochains.Cohomology
      (TopCat.of ↥(chart (X := X) W)) 1) :
    ∃ a : ℚ, z = a •
      SingularCochains.cohomologyPullback (chartProjection X Y W) 1 ξ := by
  let e := chartH1Iso X Y W
  obtain ⟨a, ha⟩ := hξ (e.inv z)
  refine ⟨a, ?_⟩
  calc
    z = e.hom (e.inv z) := (Iso.inv_hom_id_apply e z).symm
    _ = a • e.hom ξ := by rw [ha, map_smul]
    _ = a • SingularCochains.cohomologyPullback (chartProjection X Y W) 1 ξ := by
      rw [chartH1Iso_hom]

end HodgeConjecture.ProductSecondFactorH1Local

end
