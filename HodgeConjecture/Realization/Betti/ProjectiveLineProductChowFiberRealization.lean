module

public import HodgeConjecture.Cycles.ProjectiveLineProductZeroBoundaryGenerators
public import HodgeConjecture.Cycles.ProjectiveLineProductFiberChowIndependence
public import HodgeConjecture.Realization.Betti.ProjectiveLineProductFiberPairedWitness

/-!
# A fiber-basis realization from ordinary Chow to product Betti H²

The actual rational degree-one Chow group of `P¹_ℂ × P¹_ℂ` is generated by
the two zero-fiber classes, and their independence in the original rational
equivalence quotient is proved by the affine UFD argument. Their coordinates
define a unique linear map to the actual rational singular H², normalized
by the two proved supported fiber Gysin images. This map is specific to this
product; no general variety-level cycle-class naturality is asserted.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace HodgeConjecture.ProjectiveLineProductChowFiberRealization

open HodgeConjecture.ProjectiveLineProductChow
open HodgeConjecture.ProjectiveLineProductBetti
open HodgeConjecture.ProjectiveLineProductSpanning
open HodgeConjecture.ProjectiveLineProductFiberPairedWitness
open HodgeConjecture.ProjectiveLineProductZeroBoundaryGenerators
open HodgeConjecture.ProjectiveLineProductFiberChowIndependence
open HodgeConjecture.SchemeCycles

/-- The two actual ordinary rational Chow fiber classes, with rational
coefficients. -/
def fiberChowSection : ℚ × ℚ →ₗ[ℚ]
    RationalChowGroup (dimensionFunction ℂ) 1 where
  toFun ab := ab.1 • firstZeroRationalChowClass ℂ +
    ab.2 • secondZeroRationalChowClass ℂ
  map_add' a b := by
    simp only [Prod.fst_add, Prod.snd_add, add_smul]
    abel
  map_smul' c ab := by
    rcases ab with ⟨a, b⟩
    simp [Algebra.smul_def, smul_add, smul_smul]

@[simp] theorem fiberChowSection_first :
    fiberChowSection (1, 0) = firstZeroRationalChowClass ℂ := by
  simp [fiberChowSection]

@[simp] theorem fiberChowSection_second :
    fiberChowSection (0, 1) = secondZeroRationalChowClass ℂ := by
  simp [fiberChowSection]

/-- The actual product localization and affine UFD calculation make the
two named ordinary Chow classes generate the full rational quotient. -/
theorem fiberChowSection_surjective : Function.Surjective fiberChowSection := by
  intro c
  have hc : c ∈ Submodule.span ℚ
      ({firstZeroRationalChowClass ℂ, secondZeroRationalChowClass ℂ} :
        Set (RationalChowGroup (dimensionFunction ℂ) 1)) := by
    rw [rationalChowGroup_span_zero_fibers]
    trivial
  obtain ⟨a, b, hab⟩ := (Submodule.mem_span_pair).mp hc
  exact ⟨(a, b), hab⟩

/-- The affine UFD and global principal-divisor argument proves that the
two actual ordinary rational Chow fiber classes are independent. -/
theorem fiberChowSection_injective : Function.Injective fiberChowSection := by
  intro ab cd h
  have hsub : fiberChowSection (ab - cd) = 0 := by
    rw [map_sub, h, sub_self]
  rcases ab with ⟨a, b⟩
  rcases cd with ⟨c, d⟩
  have hcoeff : a - c = 0 ∧ b - d = 0 :=
    rational_zero_fiber_classes_independent (a - c) (b - d) (by
      simpa [fiberChowSection] using hsub)
  exact Prod.ext (sub_eq_zero.mp hcoeff.1) (sub_eq_zero.mp hcoeff.2)

/-- The precise Chow relation input required to turn the two fiber
generators into coordinates on the actual ordinary rational Chow group. -/
def fiberChowEquiv (hind : Function.Injective fiberChowSection) :
    (ℚ × ℚ) ≃ₗ[ℚ] RationalChowGroup (dimensionFunction ℂ) 1 :=
  LinearEquiv.ofBijective fiberChowSection ⟨hind, fiberChowSection_surjective⟩

/-- The unique linear realization of the actual rational Chow quotient
that sends the two zero-fiber classes to their supported Betti images.
It is available once independence of those Chow classes is proved. -/
def fiberBettiRealization (hind : Function.Injective fiberChowSection) :
    RationalChowGroup (dimensionFunction ℂ) 1 →ₗ[ℚ] ProductH2 :=
  coordinateSection.comp (fiberChowEquiv hind).symm.toLinearMap

theorem fiberBettiRealization_section
    (hind : Function.Injective fiberChowSection) (ab : ℚ × ℚ) :
    fiberBettiRealization hind (fiberChowSection ab) = coordinateSection ab := by
  change coordinateSection
    ((fiberChowEquiv hind).symm ((fiberChowEquiv hind) ab)) = _
  rw [LinearEquiv.symm_apply_apply]

/-- The actual first zero-fiber Chow class realizes to its proved
supported Gysin/Betti class. -/
theorem fiberBettiRealization_first
    (hind : Function.Injective fiberChowSection) :
    fiberBettiRealization hind (firstZeroRationalChowClass ℂ) = firstClass := by
  rw [← fiberChowSection_first, fiberBettiRealization_section]
  simp [coordinateSection]

/-- The corresponding second zero-fiber normalization. -/
theorem fiberBettiRealization_second
    (hind : Function.Injective fiberChowSection) :
    fiberBettiRealization hind (secondZeroRationalChowClass ℂ) = secondClass := by
  rw [← fiberChowSection_second, fiberBettiRealization_section]
  simp [coordinateSection]

/-- Spanning in the actual ordinary Chow quotient makes the fiber
normalization determine at most one linear realization. -/
theorem fiberBettiRealization_unique
    (hind : Function.Injective fiberChowSection)
    (f : RationalChowGroup (dimensionFunction ℂ) 1 →ₗ[ℚ] ProductH2)
    (hfirst : f (firstZeroRationalChowClass ℂ) = firstClass)
    (hsecond : f (secondZeroRationalChowClass ℂ) = secondClass) :
    f = fiberBettiRealization hind := by
  apply LinearMap.ext
  intro c
  obtain ⟨⟨a, b⟩, rfl⟩ := fiberChowSection_surjective c
  rw [fiberBettiRealization_section]
  simp [fiberChowSection, coordinateSection, hfirst, hsecond]

/-- The realization sends the earlier ordinary Chow witness for any
product Betti class back to that class. -/
theorem fiberBettiRealization_fiberChowClass
    (hind : Function.Injective fiberChowSection) (z : ProductH2) :
    fiberBettiRealization hind (fiberChowClass z) = z := by
  have hclass : fiberChowClass z = fiberChowSection (coordinateEquiv z) := by
    rw [fiberChowClass_eq]
    rfl
  rw [hclass, fiberBettiRealization_section]
  have hcoord : coordinateProbe (coordinateSection (coordinateEquiv z)) =
      coordinateProbe z := by
    rw [coordinateProbe_section]
    rfl
  exact coordinateProbe_injective hcoord

theorem fiberBettiRealization_surjective
    (hind : Function.Injective fiberChowSection) :
    Function.Surjective (fiberBettiRealization hind) := by
  intro z
  exact ⟨fiberChowClass z, fiberBettiRealization_fiberChowClass hind z⟩

/-- The unconditional linear realization from the original ordinary
rational Chow quotient of `P¹_ℂ × P¹_ℂ` to its actual rational singular H².
Its two fiber values are the independently constructed supported Gysin
classes; this construction does not claim a general natural cycle map. -/
def ordinaryChowCycleClass :
    RationalChowGroup (dimensionFunction ℂ) 1 →ₗ[ℚ] ProductH2 :=
  fiberBettiRealization fiberChowSection_injective

theorem ordinaryChowCycleClass_first :
    ordinaryChowCycleClass (firstZeroRationalChowClass ℂ) = firstClass :=
  fiberBettiRealization_first fiberChowSection_injective

theorem ordinaryChowCycleClass_second :
    ordinaryChowCycleClass (secondZeroRationalChowClass ℂ) = secondClass :=
  fiberBettiRealization_second fiberChowSection_injective

/-- Every class in the actual product's rational singular H² is realized
by the ordinary Chow class of an actual rational fiber cycle. -/
theorem ordinaryChowCycleClass_fiberChowClass (z : ProductH2) :
    ordinaryChowCycleClass (fiberChowClass z) = z :=
  fiberBettiRealization_fiberChowClass fiberChowSection_injective z

theorem ordinaryChowCycleClass_surjective :
    Function.Surjective ordinaryChowCycleClass :=
  fiberBettiRealization_surjective fiberChowSection_injective

/-- The two proved Betti coordinate probes also make the product's
ordinary Chow realization injective. -/
theorem ordinaryChowCycleClass_injective :
    Function.Injective ordinaryChowCycleClass := by
  intro c d h
  have hcoord :
      (fiberChowEquiv fiberChowSection_injective).symm c =
        (fiberChowEquiv fiberChowSection_injective).symm d := by
    change coordinateSection
      ((fiberChowEquiv fiberChowSection_injective).symm c) =
        coordinateSection
          ((fiberChowEquiv fiberChowSection_injective).symm d) at h
    have hp := congrArg coordinateProbe h
    simpa only [coordinateProbe_section] using hp
  exact (fiberChowEquiv fiberChowSection_injective).symm.injective hcoord

/-- On this specific scheme product, ordinary rational divisor Chow and
rational singular H² are linearly equivalent through the two actual
zero-fiber classes and their supported Gysin images. -/
def ordinaryChowBettiEquiv :
    RationalChowGroup (dimensionFunction ℂ) 1 ≃ₗ[ℚ] ProductH2 :=
  LinearEquiv.ofBijective ordinaryChowCycleClass
    ⟨ordinaryChowCycleClass_injective, ordinaryChowCycleClass_surjective⟩

end HodgeConjecture.ProjectiveLineProductChowFiberRealization

end
