module

public import HodgeConjecture.Realization.Betti.ProjectiveLineProductOverlapH1
public import HodgeConjecture.Realization.Betti.ProductSecondFactorH1Criterion
public import HodgeConjecture.Realization.Betti.ProductSecondFactorH1Local

/-!
# Degree-one singular cohomology of the punctured projective-line product

The second projective-line factor has two contractible affine charts. Pulling
this cover back to the product with the punctured complex plane and applying
the original singular Mayer–Vietoris sequence shows that its H¹ is generated
by pullback of the circle class from the punctured first factor.
-/

@[expose] public section

set_option autoImplicit false
set_option linter.style.haveILetI false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

noncomputable section

namespace HodgeConjecture.ProjectiveLineProductOverlapH1

open CategoryTheory HodgeConjecture.SingularSubcomplexes
open ProjectiveLineAnalyticCover ProductSecondFactorCover

instance planePathConnected : PathConnectedSpace Plane := by
  letI : PathConnectedSpace PuncturedComplexCircle.Radius :=
    isPathConnected_iff_pathConnectedSpace.mp
      ((convex_Ioi (0 : ℝ)).isPathConnected ⟨1, zero_lt_one⟩)
  exact PuncturedComplexCircle.polarHomeomorph.symm.pathConnectedSpace

abbrev firstOpen : Set (Plane × LinePoint) :=
  chart (X := Plane) finiteOpen

abbrev secondOpen : Set (Plane × LinePoint) :=
  chart (X := Plane) reciprocalOpen

/-- The original singular class pulled back from the punctured first factor. -/
def productGenerator : ProductH1 :=
  SingularCochains.cohomologyPullback planeProjection 1 planeGenerator

theorem chartProjection_comp (W : Set LinePoint) :
    subsetInclusion (TopCat.of (Plane × LinePoint)) (chart W) ≫ planeProjection =
      ProductSecondFactorH1Local.chartProjection Plane LinePoint W := by
  ext z : 1
  rfl

theorem chart_restriction_productGenerator (W : Set LinePoint) :
    SingularCochains.cohomologyPullback
      (subsetInclusion (TopCat.of (Plane × LinePoint)) (chart W)) 1
        productGenerator =
      SingularCochains.cohomologyPullback
        (ProductSecondFactorH1Local.chartProjection Plane LinePoint W) 1
          planeGenerator := by
  have h := congrArg
    (fun f : TopCat.of ↥(chart (X := Plane) W) ⟶ TopCat.of Plane =>
      SingularCochains.cohomologyPullback f 1 planeGenerator)
    (chartProjection_comp W)
  rw [SingularCochains.cohomologyPullback_comp] at h
  exact h

/-- Each original affine second-factor chart H¹ is generated by restriction
of the same actual class on the product. -/
theorem chartH1_generated (W : Set LinePoint) [ContractibleSpace W]
    (y : SingularCochains.Cohomology (TopCat.of ↥(chart (X := Plane) W)) 1) :
    ∃ a : ℚ, y = a •
      SingularCochains.cohomologyPullback
        (subsetInclusion (TopCat.of (Plane × LinePoint)) (chart W)) 1
          productGenerator := by
  obtain ⟨a, ha⟩ := ProductSecondFactorH1Local.chartH1_generated
    Plane LinePoint W planeGenerator planeH1_generated y
  refine ⟨a, ?_⟩
  rw [chart_restriction_productGenerator]
  exact ha

/-- Projection of the chart intersection to the punctured first factor. -/
def overlapProjection :
    TopCat.of ↥(firstOpen ∩ secondOpen) ⟶ TopCat.of Plane :=
  TopCat.ofHom ⟨fun z => z.val.1,
    continuous_fst.comp continuous_subtype_val⟩

/-- The common second-factor point supplies a continuous section. -/
def overlapSection :
    TopCat.of Plane ⟶ TopCat.of ↥(firstOpen ∩ secondOpen) :=
  TopCat.ofHom ⟨fun z =>
    ⟨(z, (ProjectiveLineDegreeOne.overlapPoint : ↥(finiteOpen ∩ reciprocalOpen)).val),
      ⟨ProjectiveLineDegreeOne.overlapPoint.property.1,
        ProjectiveLineDegreeOne.overlapPoint.property.2⟩⟩,
    (continuous_id.prodMk continuous_const).subtype_mk _⟩

@[simp] theorem overlapSection_projection :
    overlapSection ≫ overlapProjection = 𝟙 (TopCat.of Plane) := by
  ext z : 1
  rfl

theorem overlapProjection_pullback_injective :
    Function.Injective
      (SingularCochains.cohomologyPullback overlapProjection 1) := by
  intro x y hxy
  have h := congrArg
    (fun z : SingularCochains.Cohomology
      (TopCat.of ↥(firstOpen ∩ secondOpen)) 1 =>
      SingularCochains.cohomologyPullback overlapSection 1 z) hxy
  simpa only [← ModuleCat.comp_apply, ← SingularCochains.cohomologyPullback_comp,
    overlapSection_projection, SingularCochains.cohomologyPullback_id,
    ModuleCat.id_apply] using h

theorem overlapProjection_generator_ne_zero :
    SingularCochains.cohomologyPullback overlapProjection 1 planeGenerator ≠ 0 := by
  intro h
  apply planeGenerator_ne_zero
  apply overlapProjection_pullback_injective
  simpa only [map_zero] using h

theorem overlapProjection_comp :
    SingularMayerVietoris.intersectionToLeft
      (TopCat.of (Plane × LinePoint)) firstOpen secondOpen ≫
      subsetInclusion (TopCat.of (Plane × LinePoint)) firstOpen ≫ planeProjection =
      overlapProjection := by
  ext z : 1
  rfl

/-- The left chart generator remains nonzero after restriction to the
intersection. -/
theorem firstChart_overlap_ne_zero :
    SingularCochains.cohomologyPullback
      (SingularMayerVietoris.intersectionToLeft
        (TopCat.of (Plane × LinePoint)) firstOpen secondOpen) 1
      (SingularMayerVietoris.restriction
        (TopCat.of (Plane × LinePoint)) firstOpen secondOpen 1
          productGenerator).1 ≠ 0 := by
  have h := congrArg
    (fun f : TopCat.of ↥(firstOpen ∩ secondOpen) ⟶ TopCat.of Plane =>
      SingularCochains.cohomologyPullback f 1 planeGenerator)
    overlapProjection_comp
  rw [SingularCochains.cohomologyPullback_comp,
    SingularCochains.cohomologyPullback_comp] at h
  have heq :
      SingularCochains.cohomologyPullback
        (SingularMayerVietoris.intersectionToLeft
          (TopCat.of (Plane × LinePoint)) firstOpen secondOpen) 1
        (SingularMayerVietoris.restriction
          (TopCat.of (Plane × LinePoint)) firstOpen secondOpen 1
            productGenerator).1 =
      SingularCochains.cohomologyPullback overlapProjection 1 planeGenerator := by
    rw [SingularMayerVietoris.restriction_apply]
    simpa only [productGenerator, CategoryTheory.comp_apply] using h
  rw [heq]
  exact overlapProjection_generator_ne_zero

/-- Every original rational singular degree-one class of `ℂ* × P¹(ℂ)` is
a rational multiple of the first projection class. -/
theorem productH1_generated (z : ProductH1) :
    ∃ a : ℚ, z = a • productGenerator := by
  have hleft : ∀ y : SingularCochains.Cohomology (TopCat.of firstOpen) 1,
      ∃ a : ℚ, y = a •
        (SingularMayerVietoris.restriction
          (TopCat.of (Plane × LinePoint)) firstOpen secondOpen 1 productGenerator).1 := by
    intro y
    obtain ⟨a, ha⟩ := chartH1_generated finiteOpen y
    refine ⟨a, ?_⟩
    rw [SingularMayerVietoris.restriction_apply]
    exact ha
  have hright : ∀ y : SingularCochains.Cohomology (TopCat.of secondOpen) 1,
      ∃ a : ℚ, y = a •
        (SingularMayerVietoris.restriction
          (TopCat.of (Plane × LinePoint)) firstOpen secondOpen 1 productGenerator).2 := by
    intro y
    obtain ⟨a, ha⟩ := chartH1_generated reciprocalOpen y
    refine ⟨a, ?_⟩
    rw [SingularMayerVietoris.restriction_apply]
    exact ha
  exact ProductSecondFactorH1Criterion.generated_of_chart_data
    finiteOpen reciprocalOpen isOpen_finiteOpen isOpen_reciprocalOpen cover
    ⟨1, one_ne_zero⟩ ProjectiveLineDegreeOne.overlapPoint productGenerator
      hleft hright firstChart_overlap_ne_zero z

end HodgeConjecture.ProjectiveLineProductOverlapH1

end
