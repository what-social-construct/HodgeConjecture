module

public import HodgeConjecture.Realization.Betti.ProjectiveLineProductAlmostSpanning
public import HodgeConjecture.Realization.Betti.ProjectiveLineProductAffineOverlapTopology
public import HodgeConjecture.Realization.Betti.ProjectiveLineProductOverlapH1Spanning

/-!
# Rational singular H² of the product of projective lines

The actual complex points of the scheme product have two affine-first-factor
charts. Their overlap is homeomorphic to the punctured complex plane times
the projective line. Its rational singular H¹ is one-dimensional. Combining
this calculation with the checked chart cohomology and Mayer–Vietoris proves
that the two projection-pullback classes span the original product H².
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace HodgeConjecture.ProjectiveLineProductSpanning

open HodgeConjecture.ProjectiveLineProductBetti
open HodgeConjecture.ProjectiveLineProductAffineOverlapH2
open CategoryTheory

/-- The actual scheme-product chart overlap, expressed using the canonical
projective-line point topology of the punctured-plane H¹ calculation. -/
def canonicalOverlapHomeomorph :
    W ≃ₜ PuncturedComplexCircle.Plane × ProjectiveLineComplexPoints.Point :=
  overlapHomeomorph.trans ((Homeomorph.refl PuncturedComplexCircle.Plane).prodCongr
    ProjectiveLineComplexPoints.canonicalHomeomorph.symm)

/-- The established punctured-plane class, transported to the actual overlap. -/
def overlapGenerator : SingularCochains.Cohomology (TopCat.of W) 1 :=
  (SingularHomotopy.homeomorphIso canonicalOverlapHomeomorph 1).hom
    ProjectiveLineProductOverlapH1.productGenerator

/-- The original rational singular H¹ of the actual product-chart overlap
is generated by its transported punctured-plane class. -/
theorem overlapH1_generated
    (t : SingularCochains.Cohomology (TopCat.of W) 1) :
    ∃ a : ℚ, t = a • overlapGenerator := by
  let e := SingularHomotopy.homeomorphIso canonicalOverlapHomeomorph 1
  obtain ⟨a, ha⟩ := ProjectiveLineProductOverlapH1.productH1_generated (e.inv t)
  refine ⟨a, ?_⟩
  calc
    t = e.hom (e.inv t) := (Iso.inv_hom_id_apply e t).symm
    _ = e.hom (a • ProjectiveLineProductOverlapH1.productGenerator) := by rw [ha]
    _ = a • overlapGenerator := by rw [map_smul]; rfl

/-- The two actual scheme-projection pullback classes span the original
rational singular degree-two cohomology of `P¹_ℂ × P¹_ℂ`. -/
theorem classes_span (z : ProductH2) :
    ∃ a b : ℚ, z = a • firstClass + b • secondClass :=
  ProjectiveLineProductAlmostSpanning.classes_span_of_overlapH1_generated
    overlapGenerator overlapH1_generated z

theorem coordinateSection_surjective : Function.Surjective coordinateSection := by
  intro z
  obtain ⟨a, b, h⟩ := classes_span z
  exact ⟨(a, b), h.symm⟩

theorem coordinateProbe_injective : Function.Injective coordinateProbe := by
  intro x y hxy
  obtain ⟨a, rfl⟩ := coordinateSection_surjective x
  obtain ⟨b, rfl⟩ := coordinateSection_surjective y
  simpa only [coordinateProbe_section] using congrArg coordinateSection hxy

/-- The two fiber probes give explicit rational coordinates on the actual
degree-two singular cohomology of the projective-line scheme product. -/
def coordinateEquiv : ProductH2 ≃ₗ[ℚ] ℚ × ℚ :=
  LinearEquiv.ofBijective coordinateProbe
    ⟨coordinateProbe_injective, coordinateProbe_surjective⟩

end HodgeConjecture.ProjectiveLineProductSpanning

end
