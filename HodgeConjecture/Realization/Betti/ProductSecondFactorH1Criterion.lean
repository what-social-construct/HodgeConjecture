module

public import HodgeConjecture.Realization.Betti.ProductSecondFactorCover

/-!
# Mayer–Vietoris H¹ criterion for a product cover

For a two-open cover pulled back from the second factor, connectedness of the
overlap makes the degree-zero difference surjective and hence the degree-one
restriction injective. If both chart H¹ groups are generated by restrictions
of one global class, and that class remains nonzero on the overlap, then it
generates the original singular H¹ of the product. This is the exact algebraic
step for `ℂ* × P¹`; its chart hypotheses are separate topology calculations.
-/

@[expose] public section

set_option autoImplicit false
set_option linter.style.haveILetI false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

noncomputable section

namespace HodgeConjecture.ProductSecondFactorH1Criterion

open CategoryTheory ProductSecondFactorCover

variable {X Y : Type} [TopologicalSpace X] [TopologicalSpace Y]

theorem generated_of_chart_data
    (U V : Set Y) (hU : IsOpen U) (hV : IsOpen V)
    (hcover : U ∪ V = Set.univ)
    [PathConnectedSpace X] [PathConnectedSpace ↥(U ∩ V)]
    (x : X) (p : ↥(U ∩ V))
    (ξ : SingularCochains.Cohomology (TopCat.of (X × Y)) 1)
    (hleft : ∀ y : SingularCochains.Cohomology
      (TopCat.of ↥(chart (X := X) U)) 1,
        ∃ a : ℚ, y = a •
          (SingularMayerVietoris.restriction (TopCat.of (X × Y))
            (chart U) (chart V) 1 ξ).1)
    (hright : ∀ y : SingularCochains.Cohomology
      (TopCat.of ↥(chart (X := X) V)) 1,
        ∃ b : ℚ, y = b •
          (SingularMayerVietoris.restriction (TopCat.of (X × Y))
            (chart U) (chart V) 1 ξ).2)
    (hnonzero : SingularCochains.cohomologyPullback
      (SingularMayerVietoris.intersectionToLeft (TopCat.of (X × Y))
        (chart U) (chart V)) 1
        (SingularMayerVietoris.restriction (TopCat.of (X × Y))
          (chart U) (chart V) 1 ξ).1 ≠ 0)
    (z : SingularCochains.Cohomology (TopCat.of (X × Y)) 1) :
    ∃ a : ℚ, z = a • ξ := by
  let P := TopCat.of (X × Y)
  let A := chart (X := X) U
  let B := chart (X := X) V
  let r := SingularMayerVietoris.restriction P A B 1
  let d := SingularMayerVietoris.difference P A B 1
  let f := SingularCochains.cohomologyPullback
    (SingularMayerVietoris.intersectionToLeft P A B) 1
  let g := SingularCochains.cohomologyPullback
    (SingularMayerVietoris.intersectionToRight P A B) 1
  let hA : IsOpen A := isOpen_chart U hU
  let hB : IsOpen B := isOpen_chart V hV
  let hAB : A ∪ B = Set.univ := chart_cover U V hcover
  letI : Epi (SingularMayerVietoris.difference P A B 0) :=
    (ModuleCat.epi_iff_surjective _).mpr
      (difference_zero_surjective U V x p)
  have hconnecting : SingularMayerVietoris.connecting P A B hA hB hAB 0 = 0 := by
    apply (cancel_epi (SingularMayerVietoris.difference P A B 0)).mp
    exact SingularMayerVietoris.difference_comp_connecting P A B hA hB hAB 0
  let S := SingularMayerVietoris.unionSequence P A B hA hB hAB 0
  have hS : S.Exact := SingularMayerVietoris.unionSequence_exact P A B hA hB hAB 0
  have hSf : S.f = SingularMayerVietoris.connecting P A B hA hB hAB 0 := by
    simpa only [S] using SingularMayerVietoris.unionSequence_f P A B hA hB hAB 0
  have hSg : S.g = r := by
    simpa only [S, r, Nat.reduceAdd] using
      SingularMayerVietoris.unionSequence_g P A B hA hB hAB 0
  have hrmono : Mono r := by
    have hzero : S.f = 0 := by rw [hSf]; exact hconnecting
    have h : Mono S.g := hS.mono_g hzero
    rw [hSg] at h
    exact h
  have hrinjective : Function.Injective r := (ModuleCat.mono_iff_injective r).mp hrmono
  obtain ⟨a, ha⟩ := hleft (r z).1
  obtain ⟨b, hb⟩ := hright (r z).2
  have hdz : d (r z) = 0 := by
    have h := SingularMayerVietoris.restriction_comp_difference P A B hA hB hAB 1
    exact congrArg (fun k : SingularCochains.Cohomology P 1 ⟶ _ ↦ k z) h
  have hdξ : d (r ξ) = 0 := by
    have h := SingularMayerVietoris.restriction_comp_difference P A B hA hB hAB 1
    exact congrArg (fun k : SingularCochains.Cohomology P 1 ⟶ _ ↦ k ξ) h
  rw [SingularMayerVietoris.difference_apply] at hdz hdξ
  have hfg : f (r ξ).1 = g (r ξ).2 := sub_eq_zero.mp hdξ
  have hcoeff : a = b := by
    rw [ha, hb, map_smul, map_smul, ← hfg] at hdz
    have hzero : (a - b) • f (r ξ).1 = 0 := by
      simpa only [sub_smul] using hdz
    exact sub_eq_zero.mp ((smul_eq_zero.mp hzero).resolve_right hnonzero)
  subst b
  refine ⟨a, ?_⟩
  apply hrinjective
  apply Prod.ext
  · change (r z).1 = a • (r ξ).1 at ha
    rw [map_smul]
    change (r z).1 = a • (r ξ).1
    exact ha
  · change (r z).2 = a • (r ξ).2 at hb
    rw [map_smul]
    change (r z).2 = a • (r ξ).2
    exact hb

end HodgeConjecture.ProductSecondFactorH1Criterion

end
