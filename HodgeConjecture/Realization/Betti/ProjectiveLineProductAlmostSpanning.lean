module

public import HodgeConjecture.Realization.Betti.ProjectiveLineProductAffineOverlapH2

/-!
# The remaining overlap input for product H² spanning

The actual first-factor affine charts cover the complex points of the scheme
product. Their degree-two cohomology is generated by the second projection
class, the first projection class vanishes on both, and the second chart's
restriction to the overlap is injective. Mayer–Vietoris therefore reduces
full degree-two spanning to one precise statement: the overlap's rational
singular first cohomology is generated by one class.
-/

@[expose] public section

set_option autoImplicit false

noncomputable section

namespace HodgeConjecture.ProjectiveLineProductAlmostSpanning

open CategoryTheory
open HodgeConjecture.ProjectiveLineProductBetti
open HodgeConjecture.ProjectiveLineProductAffineChartH2
open HodgeConjecture.ProjectiveLineProductAffineOverlapH2

/-- The sole remaining local calculation for the two projection classes to
span the actual scheme product's rational singular degree-two cohomology. -/
theorem classes_span_of_overlapH1_generated
    (κ : SingularCochains.Cohomology (TopCat.of W) 1)
    (hκ : ∀ t : SingularCochains.Cohomology (TopCat.of W) 1,
      ∃ a : ℚ, t = a • κ)
    (z : ProductH2) :
    ∃ a b : ℚ, z = a • firstClass + b • secondClass := by
  apply classes_span_of_local_cover U V
    (chartSet_isOpen false) (chartSet_isOpen true) chartSet_cover κ hκ
  · apply Prod.ext
    · rw [SingularMayerVietoris.restriction_apply]
      exact chart_firstClass_eq_zero false
    · rw [SingularMayerVietoris.restriction_apply]
      exact chart_firstClass_eq_zero true
  · intro y
    rw [SingularMayerVietoris.restriction_apply]
    exact chartH2_generated false y
  · exact overlapRestriction_injective

end HodgeConjecture.ProjectiveLineProductAlmostSpanning

end
