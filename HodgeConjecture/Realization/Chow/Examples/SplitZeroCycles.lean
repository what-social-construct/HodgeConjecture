import HodgeConjecture.Correspondence.Examples.SplitIntegralSubschemes
import Mathlib.LinearAlgebra.Finsupp.LSum

/-!
# Zero-cycles on actual finite split subschemes

The cycle module is freely generated by integral closed subschemes, represented
by their ideal-sheaf data. The classification of these subschemes provides a
coordinate equivalence with functions on the point labels. The cycle module
itself is defined before choosing these coordinates.
-/

set_option autoImplicit false

namespace HodgeConjecture

noncomputable section

universe u v

namespace SplitZeroCycles

open SplitPointGeometry

variable (K : Type u) [Field K] (I : Type u) [Finite I]
variable (R : Type v)

/-- Zero-cycles with coefficients in `R`, on actual integral closed subschemes.
Every generator has dimension zero by `integralClosedSubscheme_dimension`. -/
abbrev Cycles [Zero R] := SchemeCycles.Cycles (scheme K I) R

variable [Semiring R]

/-- The fundamental zero-cycle of the labelled reduced rational point. -/
def pointCycle (i : I) : Cycles K I R :=
  Finsupp.single (pointIntegralSubscheme K I i) 1

/-- Coordinates are induced by the classification of actual integral closed
subschemes, followed by the finite-support/function equivalence. -/
def coordinates : Cycles K I R ≃ₗ[R] (I → R) :=
  (Finsupp.domLCongr (labelEquivIntegralClosedSubscheme K I).symm).trans
    (Finsupp.linearEquivFunOnFinite R R I)

@[simp]
theorem coordinates_apply (z : Cycles K I R) (i : I) :
    coordinates K I R z i = z (pointIntegralSubscheme K I i) := by
  simp [coordinates, Finsupp.domCongr_apply]

@[simp]
theorem coordinates_single [DecidableEq I]
    (J : IntegralClosedSubscheme K I) (r : R) :
    coordinates K I R (Finsupp.single J r) =
      Pi.single ((labelEquivIntegralClosedSubscheme K I).symm J) r := by
  simp [coordinates]

@[simp]
theorem coordinates_pointCycle [DecidableEq I] (i : I) :
    coordinates K I R (pointCycle K I R i) = Pi.single i 1 := by
  simpa only [pointCycle, ← labelEquivIntegralClosedSubscheme_apply,
    Equiv.symm_apply_apply] using
      coordinates_single K I R (pointIntegralSubscheme K I i) 1

@[simp]
theorem coordinates_symm_single [DecidableEq I] (i : I) (r : R) :
    (coordinates K I R).symm (Pi.single i r) =
      Finsupp.single (pointIntegralSubscheme K I i) r := by
  apply (coordinates K I R).injective
  simp only [LinearEquiv.apply_symm_apply, coordinates_single,
    ← labelEquivIntegralClosedSubscheme_apply, Equiv.symm_apply_apply]

/-- Equality of cycles is detected by their coefficients on the actual point
subschemes. -/
theorem ext (z w : Cycles K I R)
    (h : ∀ i, z (pointIntegralSubscheme K I i) =
      w (pointIntegralSubscheme K I i)) : z = w :=
  (coordinates K I R).injective (funext fun i ↦ by simpa using h i)

omit [Semiring R] in
/-- Coefficient extension from integral to rational zero-cycles. -/
def rationalize : Cycles K I ℤ →ₗ[ℤ] Cycles K I ℚ :=
  Finsupp.mapRange.linearMap (Int.castAddHom ℚ).toIntLinearMap

omit [Finite I] in
@[simp]
theorem rationalize_apply (z : Cycles K I ℤ) (J : IntegralClosedSubscheme K I) :
    rationalize K I z J = (z J : ℚ) := rfl

omit [Finite I] in
theorem rationalize_injective : Function.Injective (rationalize K I) := by
  intro z w h
  apply Finsupp.ext
  intro J
  exact Int.cast_injective (congrArg (fun t : Cycles K I ℚ ↦ t J) h)

omit [Finite I] in
@[simp]
theorem rationalize_pointCycle (i : I) :
    rationalize K I (pointCycle K I ℤ i) = pointCycle K I ℚ i := by
  simp [rationalize, pointCycle, Finsupp.mapRange.linearMap]

@[simp]
theorem coordinates_rationalize (z : Cycles K I ℤ) (i : I) :
    coordinates K I ℚ (rationalize K I z) i = (coordinates K I ℤ z i : ℚ) := by
  simp

end SplitZeroCycles

end

end HodgeConjecture
