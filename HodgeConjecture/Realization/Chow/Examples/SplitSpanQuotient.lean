import HodgeConjecture.Realization.Chow.Examples.SplitSpanRealization
import HodgeConjecture.Realization.Chow.Presentation
import HodgeConjecture.Correspondence.Examples.SplitSpanDecomposition

/-!
# The additive quotient of actual finite split scheme spans

The relation ideal is generated explicitly by decomposing a finite split
span into its singleton spans. It is not defined to be the kernel of the
matrix realization. The theorem below identifies that kernel and proves
the resulting noncommutative quotient is the matrix algebra.

This is the additive span presentation. Identifying it with a scheme's
Chow correspondence algebra or with a Betti cycle-class map is a separate
geometric comparison, not a definition made here.
-/

set_option autoImplicit false

namespace HodgeConjecture

open Classical
open scoped BigOperators

noncomputable section

universe u

namespace SplitSpanRealization

variable (K : Type u) [Field K]
variable (I : Type u) [Fintype I] [DecidableEq I]
variable {S T : Type u} [Fintype S] [Fintype T]

/-- The singleton geometric span with input `i` and output `j`. -/
def pointSpanClass (i j : I) : FreeAlgebra K I :=
  ofSchemeSpan K I (fun _ : PUnit.{u+1} => i) (fun _ => j)

/-- The explicit finite-point decomposition defect. -/
def decompositionDefect (left right : S → I) : FreeAlgebra K I :=
  ofSchemeSpan K I left right - ∑ s, pointSpanClass K I (left s) (right s)

/-- All finite-point decomposition relations, over every split presentation. -/
def decompositionGenerators : Set (FreeAlgebra K I) :=
  {x | ∃ (c : SplitClass K I) (P : Presentation K I c.val),
    x = decompositionDefect K I P.left P.right}

/-- The two-sided ideal generated by finite coproduct decomposition, not by
an a priori kernel prescription. -/
def additiveRelations : TwoSidedIdeal (FreeAlgebra K I) :=
  TwoSidedIdeal.span (decompositionGenerators K I)

omit [DecidableEq I] in
theorem decompositionDefect_mem (left right : S → I) :
    decompositionDefect K I left right ∈ additiveRelations K I :=
  TwoSidedIdeal.subset_span
    ⟨ofSpan K I left right, spanPresentation K I left right, rfl⟩

/-- Linear normal form: write a matrix as the same combination of actual
singleton span classes. This section is linear, not a free-algebra map. -/
def pointNormalForm : Matrix I I ℚ →ₗ[ℚ] FreeAlgebra K I where
  toFun M := ∑ i, ∑ j, M i j • pointSpanClass K I j i
  map_add' M N := by
    simp only [Matrix.add_apply, add_smul, Finset.sum_add_distrib]
  map_smul' q M := by
    simp only [Matrix.smul_apply, smul_eq_mul, mul_smul, Finset.smul_sum]
    rfl

@[simp]
theorem pointNormalForm_single (i j : I) :
    pointNormalForm K I (Matrix.single j i 1) = pointSpanClass K I i j := by
  simp [pointNormalForm, Matrix.single, ite_and]

omit [DecidableEq I] in
theorem pointNormalForm_matrix (left right : S → I) :
    pointNormalForm K I (FiniteSpanMatrix.matrix left right) =
      ∑ s, pointSpanClass K I (left s) (right s) := by
  simp only [FiniteSpanMatrix.matrix, map_sum, pointNormalForm_single]

@[simp]
theorem realization_pointSpanClass (i j : I) :
    realization K I (pointSpanClass K I i j) = Matrix.single j i 1 := by
  ext a b
  simp [pointSpanClass, FiniteSpanMatrix.matrix, Matrix.single]

/-- The singleton normal form is a linear right inverse to incidence
realization, without claiming to be a map of the raw algebras. -/
@[simp]
theorem realization_pointNormalForm (M : Matrix I I ℚ) :
    realization K I (pointNormalForm K I M) = M := by
  change realization K I (∑ i, ∑ j, M i j • pointSpanClass K I j i) = M
  simp only [map_sum, map_smul, realization_pointSpanClass]
  ext i j
  simp [Matrix.single, Matrix.sum_apply, ite_and]

theorem realization_decompositionDefect (left right : S → I) :
    realization K I (decompositionDefect K I left right) = 0 := by
  simp only [decompositionDefect, map_sub, realization_ofSchemeSpan, map_sum,
    realization_pointSpanClass, FiniteSpanMatrix.matrix]
  apply sub_eq_zero.mpr
  apply Finset.sum_congr rfl
  intro s _
  ext a b
  simp [Matrix.single]

theorem additiveRelations_le_ker :
    additiveRelations K I ≤ TwoSidedIdeal.ker (realization K I) := by
  apply TwoSidedIdeal.span_le.mpr
  rintro x ⟨c, P, rfl⟩
  exact (TwoSidedIdeal.mem_ker _).mpr (realization_decompositionDefect K I P.left P.right)

/-- Every raw span combination reduces modulo the explicit relations to
the singleton combination prescribed by its matrix coefficients. -/
theorem sub_pointNormalForm_mem (x : FreeAlgebra K I) :
    x - pointNormalForm K I (realization K I x) ∈ additiveRelations K I := by
  induction x using MonoidAlgebra.induction_linear with
  | zero => simp only [map_zero, sub_zero]; exact (additiveRelations K I).zero_mem
  | add x y hx hy =>
    simpa only [map_add, add_sub_add_comm] using (additiveRelations K I).add_mem hx hy
  | single c q =>
    obtain ⟨P⟩ := c.property
    have hc : ofSpan K I P.left P.right = c := by
      apply Subtype.ext
      apply Subtype.ext
      exact P.presents
    have hx : MonoidAlgebra.single c q = q • ofSchemeSpan K I P.left P.right := by
      simp [ofSchemeSpan, hc]
    rw [hx, map_smul, map_smul, ← smul_sub, realization_ofSchemeSpan,
      pointNormalForm_matrix]
    change q • decompositionDefect K I P.left P.right ∈ additiveRelations K I
    rw [Algebra.smul_def]
    exact (additiveRelations K I).mul_mem_left _ _
      (decompositionDefect_mem K I P.left P.right)

/-- Finite point-decomposition generates the full kernel. No further
relations are needed to identify the additive split-span algebra. -/
theorem additiveRelations_eq_ker :
    additiveRelations K I = TwoSidedIdeal.ker (realization K I) := by
  apply le_antisymm (additiveRelations_le_ker K I)
  intro x hx
  have hzero := (TwoSidedIdeal.mem_ker _).mp hx
  simpa only [hzero, map_zero, sub_zero] using sub_pointNormalForm_mem K I x

/-- The explicit additive presentation, using the existing noncommutative
correspondence-presentation interface. -/
def additivePresentation : CorrespondenceAlgebraPresentation (FreeAlgebra K I) where
  relations := additiveRelations K I

/-- The split-span algebra after imposing finite coproduct additivity. -/
abbrev AdditiveQuotient := (additivePresentation K I).QuotientAlgebra

/-- Incidence matrices descend to the explicit additive quotient. -/
def quotientRealization : AdditiveQuotient K I →ₐ[ℚ] Matrix I I ℚ :=
  (additivePresentation K I).lift (realization K I)
    (fun _ hx => (TwoSidedIdeal.mem_ker _).mp (additiveRelations_le_ker K I hx))

@[simp]
theorem quotientRealization_classMap (x : FreeAlgebra K I) :
    quotientRealization K I ((additivePresentation K I).classMap x) =
      realization K I x := rfl

theorem quotientRealization_bijective : Function.Bijective (quotientRealization K I) := by
  constructor
  · intro a b hab
    obtain ⟨x, rfl⟩ := (additivePresentation K I).classMap_surjective a
    obtain ⟨y, rfl⟩ := (additivePresentation K I).classMap_surjective b
    apply sub_eq_zero.mp
    rw [← map_sub, CorrespondenceAlgebraPresentation.classMap_eq_zero_iff]
    change x - y ∈ additiveRelations K I
    rw [additiveRelations_eq_ker, TwoSidedIdeal.mem_ker, map_sub, sub_eq_zero]
    exact hab
  · intro M
    obtain ⟨x, hx⟩ := realization_surjective K I M
    exact ⟨(additivePresentation K I).classMap x, hx⟩

/-- The additive quotient of actual finite split scheme spans is the full
rational matrix algebra. -/
def quotientRealizationEquiv : AdditiveQuotient K I ≃ₐ[ℚ] Matrix I I ℚ :=
  AlgEquiv.ofBijective (quotientRealization K I) (quotientRealization_bijective K I)

@[simp]
theorem quotientRealizationEquiv_classMap (x : FreeAlgebra K I) :
    quotientRealizationEquiv K I ((additivePresentation K I).classMap x) =
      realization K I x := rfl

/-- The empty-carrier class becomes zero under the explicit relations. -/
theorem empty_mem_additiveRelations [IsEmpty S] (left right : S → I) :
    ofSchemeSpan K I left right ∈ additiveRelations K I := by
  rw [additiveRelations_eq_ker, TwoSidedIdeal.mem_ker]
  exact realization_empty K I left right

omit [DecidableEq I] in
/-- A raw geometric basis vector is nonzero, even for an empty carrier.
It only becomes zero after imposing the appropriate additive relation. -/
theorem ofSchemeSpan_ne_zero (left right : S → I) :
    ofSchemeSpan K I left right ≠ 0 := by
  simp [ofSchemeSpan]

/-- The matrix realization genuinely discards raw free-span information:
the nonzero empty-span basis vector maps to zero. This also holds when
the endpoint indexing type is empty. -/
theorem realization_not_injective : ¬ Function.Injective (realization K I) := by
  intro hinj
  apply ofSchemeSpan_ne_zero K I (S := PEmpty.{u+1}) PEmpty.elim PEmpty.elim
  apply hinj
  rw [realization_empty, map_zero]

/-- The additive relation ideal is nontrivial, independently of whether
there are any endpoint points. -/
theorem additiveRelations_ne_bot : additiveRelations K I ≠ ⊥ := by
  intro h
  apply realization_not_injective K I
  apply (TwoSidedIdeal.ker_eq_bot _).mp
  rw [← additiveRelations_eq_ker, h]

/-- In particular, the finite-point relations imply binary geometric
coproduct additivity. -/
theorem sum_defect_mem_additiveRelations
    (leftS rightS : S → I) (leftT rightT : T → I) :
    ofSchemeSpan K I (Sum.elim leftS leftT) (Sum.elim rightS rightT) -
      (ofSchemeSpan K I leftS rightS + ofSchemeSpan K I leftT rightT) ∈
        additiveRelations K I := by
  rw [additiveRelations_eq_ker, TwoSidedIdeal.mem_ker, map_sub, map_add, sub_eq_zero]
  exact realization_sum K I leftS rightS leftT rightT

end SplitSpanRealization

end

end HodgeConjecture
