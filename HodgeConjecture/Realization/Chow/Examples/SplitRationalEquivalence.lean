import HodgeConjecture.Realization.Chow.Examples.SplitZeroCycleBaseChange
import Mathlib.AlgebraicGeometry.FunctionField
import Mathlib.LinearAlgebra.Quotient.Basic

/-!
# Rational equivalence on finite split schemes

The principal-divisor index uses actual integral closed curves and units of
their function fields. The dimension theorem proves this index empty. Its
unique divisor map therefore generates the zero relation submodule, and the
Chow quotient is canonically the zero-cycle module. For integral coefficients
this is the zero-dimensional specialization of Stacks, Definitions 42.8.1
(02QR) and 42.19.1 (02RW); rational coefficients use the rational span of the
same generators.
-/

set_option autoImplicit false

namespace HodgeConjecture

open AlgebraicGeometry TensorProduct

noncomputable section

universe u v

namespace SplitZeroCycles

open SplitPointGeometry

variable (K : Type u) [Field K] (I : Type u) [Finite I]

/-- The actual integral closed curves which would generate rational
equivalence of zero-cycles. -/
abbrev IntegralCurve :=
  {W : IntegralClosedSubscheme K I // topologicalKrullDim W.val.subscheme = 1}

instance (C : IntegralCurve K I) : IsIntegral C.val.val.subscheme := C.val.property

/-- There are no integral closed curves in a finite split scheme. -/
instance integralCurve_isEmpty : IsEmpty (IntegralCurve K I) := by
  refine ⟨fun C ↦ ?_⟩
  have h := C.property
  rw [integralClosedSubscheme_dimension] at h
  exact zero_ne_one h

/-- A curve together with a nonzero rational function on that actual curve. -/
def PrincipalDivisorData :=
  (C : IntegralCurve K I) × (C.val.val.subscheme.functionField)ˣ

instance principalDivisorData_isEmpty : IsEmpty (PrincipalDivisorData K I) :=
  ⟨fun d ↦ isEmptyElim d.1⟩

variable (R : Type v) [CommRing R]

/-- The principal-divisor map in this zero-dimensional case. Its source is
proved empty from the geometry, so no valuation formula is needed. -/
def principalDivisor : PrincipalDivisorData K I → Cycles K I R :=
  isEmptyElim

/-- Every divisor construction on the prescribed geometric index gives this
same map. -/
theorem principalDivisor_unique
    (D : PrincipalDivisorData K I → Cycles K I R) :
    D = principalDivisor K I R :=
  funext fun d ↦ isEmptyElim d

/-- The coefficient submodule generated by principal-divisor relations. Over
the integers this is their additive subgroup; over the rationals their span. -/
def relations : Submodule R (Cycles K I R) :=
  Submodule.span R (Set.range (principalDivisor K I R))

@[simp]
theorem relations_eq_bot : relations K I R = ⊥ := by
  simp [relations, Set.range_eq_empty]

/-- Rational equivalence of zero-cycles, before passing to the quotient. -/
def RationallyEquivalent (z w : Cycles K I R) : Prop :=
  z - w ∈ relations K I R

@[simp]
theorem rationallyEquivalent_iff_eq (z w : Cycles K I R) :
    RationallyEquivalent K I R z w ↔ z = w := by
  simp [RationallyEquivalent, sub_eq_zero]

/-- The Chow module, defined as cycles modulo principal-divisor relations. -/
abbrev Chow := Cycles K I R ⧸ relations K I R

/-- The canonical cycle-class quotient map. -/
def classMap : Cycles K I R →ₗ[R] Chow K I R :=
  (relations K I R).mkQ

/-- The zero-dimensional Chow quotient has no nonzero relations. -/
def chowEquivCycles : Chow K I R ≃ₗ[R] Cycles K I R :=
  (relations K I R).quotEquivOfEqBot (relations_eq_bot K I R)

@[simp]
theorem chowEquivCycles_classMap (z : Cycles K I R) :
    chowEquivCycles K I R (classMap K I R z) = z := rfl

@[simp]
theorem chowEquivCycles_symm_apply (z : Cycles K I R) :
    (chowEquivCycles K I R).symm z = classMap K I R z := rfl

theorem classMap_bijective : Function.Bijective (classMap K I R) :=
  (chowEquivCycles K I R).symm.bijective

/-- Chow coordinates come from the actual quotient and the actual integral
closed-subscheme classification. -/
def chowCoordinates : Chow K I R ≃ₗ[R] (I → R) :=
  (chowEquivCycles K I R).trans (coordinates K I R)

@[simp]
theorem chowCoordinates_classMap (z : Cycles K I R) :
    chowCoordinates K I R (classMap K I R z) = coordinates K I R z := rfl

@[simp]
theorem chowCoordinates_pointCycle [DecidableEq I] (i : I) :
    chowCoordinates K I R (classMap K I R (pointCycle K I R i)) =
      Pi.single i 1 := by
  simp

/-- Coefficient extension on Chow groups, induced by coefficient extension
on their actual cycle representatives. -/
def chowRationalize : Chow K I ℤ →ₗ[ℤ] Chow K I ℚ :=
  ((classMap K I ℚ).restrictScalars ℤ).comp
    ((rationalize K I).comp (chowEquivCycles K I ℤ).toLinearMap)

@[simp]
theorem chowRationalize_classMap (z : Cycles K I ℤ) :
    chowRationalize K I (classMap K I ℤ z) =
      classMap K I ℚ (rationalize K I z) := rfl

theorem chowRationalize_injective : Function.Injective (chowRationalize K I) :=
  (classMap_bijective K I ℚ).injective.comp
    ((rationalize_injective K I).comp (chowEquivCycles K I ℤ).injective)

/-- The rational Chow module is canonically the scalar extension of the
integral Chow group. -/
def chowRationalizationEquiv :
    (ℚ ⊗[ℤ] Chow K I ℤ) ≃ₗ[ℚ] Chow K I ℚ :=
  (LinearEquiv.baseChange ℤ ℚ _ _ (chowEquivCycles K I ℤ)).trans
    ((rationalizationEquiv K I).trans (chowEquivCycles K I ℚ).symm)

@[simp]
theorem chowRationalizationEquiv_tmul (q : ℚ) (z : Chow K I ℤ) :
    chowRationalizationEquiv K I (q ⊗ₜ[ℤ] z) = q • chowRationalize K I z := by
  simp [chowRationalizationEquiv, LinearEquiv.baseChange, chowRationalize]

@[simp]
theorem chowRationalizationEquiv_tmul_classMap (q : ℚ) (z : Cycles K I ℤ) :
    chowRationalizationEquiv K I (q ⊗ₜ[ℤ] classMap K I ℤ z) =
      q • classMap K I ℚ (rationalize K I z) := by
  simp

@[simp]
theorem chowRationalizationEquiv_tmul_pointCycle (q : ℚ) (i : I) :
    chowRationalizationEquiv K I (q ⊗ₜ[ℤ] classMap K I ℤ (pointCycle K I ℤ i)) =
      q • classMap K I ℚ (pointCycle K I ℚ i) := by
  simp

end SplitZeroCycles

end

end HodgeConjecture
