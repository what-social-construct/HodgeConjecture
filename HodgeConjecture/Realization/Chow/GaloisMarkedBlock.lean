module

public import HodgeConjecture.Boundary.Sheets.MarkedBlockProjector
public import HodgeConjecture.Realization.Chow.MarkedAugmentedRealization

@[expose] public section

/-!
# The marked Galois sheet block as a Tate graph projector

The boundary layer proves that multiplication by the distinguished
base-sheet selector is diagonal in selector/CRT coordinates and graph-shaped
in constant-marked coordinates.  This file identifies that graph-shaped
operator with the canonical Tate-block operator used in the Hodge target.

For a linear map from the residual sheet module to a cohomology module, the
canonical residual class is sent to a class `α`, and the induced map on the
marked products intertwines the two graph projectors.  This is only rational
linear algebra.  A Hodge application must construct the residual map from
cover geometry at the Chow or motivic level; choosing an arbitrary linear map
does not prove algebraicity or a case of the Hodge conjecture.
-/

set_option autoImplicit false

namespace HodgeConjecture

noncomputable section

universe u v

namespace MarkedSheetProjector

variable {G : Type u} [Group G]
variable (D : Subgroup G)

/-- The graph operator obtained from the marked sheet decomposition is
definitionally the canonical class graph projector of its residual class. -/
theorem graphOperator_eq_classGraphProjector :
    graphOperator D =
      ClassGraphProjector.operator (residualClass D) :=
  (markedAugmentedAlgebra D).graphOperator_eq_classGraphProjector

variable {H : Type v} [AddCommGroup H] [Module ℚ H]

/-- The class in `H` generated by a supplied rational realization of the
residual Galois-sheet module. -/
def generatedClass
    (θ : Residual D →ₗ[ℚ] H) : H :=
  (markedAugmentedAlgebra D).generatedClass θ

/-- Apply a residual realization to the second factor while preserving the
marked rational line. -/
def productRealization
    (θ : Residual D →ₗ[ℚ] H) :
    ℚ × Residual D →ₗ[ℚ] ℚ × H :=
  (markedAugmentedAlgebra D).productRealization θ

@[simp]
theorem productRealization_apply
    (θ : Residual D →ₗ[ℚ] H)
    (t : ℚ) (x : Residual D) :
    productRealization D θ (t, x) = (t, θ x) :=
  (markedAugmentedAlgebra D).productRealization_apply θ t x

/-- A surjective residual realization remains surjective after adjoining the
marked rational line. -/
theorem productRealization_surjective
    {θ : Residual D →ₗ[ℚ] H}
    (hθ : Function.Surjective θ) :
    Function.Surjective (productRealization D θ) := by
  exact (markedAugmentedAlgebra D).productRealization_surjective hθ

/-- Graph projectors are natural under a map of residual factors.  The target
class is an output of the supplied residual realization, rather than an
arbitrary class inserted into the construction. -/
theorem productRealization_intertwines_graphOperator
    (θ : Residual D →ₗ[ℚ] H) :
    (productRealization D θ).comp (graphOperator D) =
      (ClassGraphProjector.operator (generatedClass D θ)).comp
        (productRealization D θ) := by
  exact
    (markedAugmentedAlgebra D).productRealization_intertwines_graphOperator θ

/-- Combined with the marked-sheet decomposition, multiplication by the
Galois selector maps to the Tate graph projector of the generated class. -/
theorem productRealization_intertwines_selectorMultiplication
    (θ : Residual D →ₗ[ℚ] H) :
    (productRealization D θ).comp
        ((decomposition D).conj (multiplication D)) =
      (ClassGraphProjector.operator (generatedClass D θ)).comp
        (productRealization D θ) := by
  exact
    (markedAugmentedAlgebra D).productRealization_intertwines_selectorMultiplication
      θ

end MarkedSheetProjector

end

end HodgeConjecture
