import HodgeConjecture.LinearAlgebra.UniversalIdempotentAlgebra

/-!
# Morphisms between representations of one idempotent

An idempotent endomorphism `e` of an `R`-module defines a representation of
the universal one-idempotent algebra `R × R`: the distinguished selector
acts by `e` and its complement acts by `1 - e`.

A morphism between two such representations is recorded explicitly as an
`R`-linear map satisfying the intertwining identity for every element of
`R × R`.  Since that algebra is generated by its selector and the unit,
the full identity is equivalent to the single square for the selector.
-/

set_option autoImplicit false

namespace HodgeConjecture

noncomputable section

universe u v w

namespace UniversalIdempotentAlgebra

variable {R : Type u} [CommRing R]
variable {V : Type v} [AddCommGroup V] [Module R V]
variable {W : Type w} [AddCommGroup W] [Module R W]

/-- The canonical representation of the universal one-idempotent algebra
determined by an idempotent endomorphism. -/
abbrev endomorphismRepresentation
    (e : Module.End R V) (he : IsIdempotentElem e) :
    UniversalIdempotentAlgebra R →ₐ[R] Module.End R V :=
  mapOfIdempotent e he

/--
An `R`-linear morphism between the canonical representations determined by
two idempotent endomorphisms.

The equation is written without installing auxiliary module instances, which
makes the interface stable at boundaries between independently supplied
realization packages.
-/
structure RepresentationMorphism
    (eV : Module.End R V) (heV : IsIdempotentElem eV)
    (eW : Module.End R W) (heW : IsIdempotentElem eW) where
  map : V →ₗ[R] W
  intertwines :
    ∀ z : UniversalIdempotentAlgebra R,
      (endomorphismRepresentation eW heW z).comp map =
        map.comp (endomorphismRepresentation eV heV z)

namespace RepresentationMorphism

variable
  {eV : Module.End R V} {heV : IsIdempotentElem eV}
  {eW : Module.End R W} {heW : IsIdempotentElem eW}

/-- A full representation morphism intertwines the distinguished
idempotents. -/
theorem selector_intertwines
    (T : RepresentationMorphism eV heV eW heW) :
    eW.comp T.map = T.map.comp eV := by
  simpa only [endomorphismRepresentation, mapOfIdempotent_selector] using
    T.intertwines (selector (R := R))

/-- A single commuting square for the distinguished idempotents extends to
an intertwiner for every element of the universal algebra. -/
def ofSelectorIntertwines
    (Theta : V →ₗ[R] W)
    (hTheta : eW.comp Theta = Theta.comp eV) :
    RepresentationMorphism eV heV eW heW where
  map := Theta
  intertwines := by
    rintro ⟨a, b⟩
    apply LinearMap.ext
    intro x
    have hx := LinearMap.congr_fun hTheta x
    change eW (Theta x) = Theta (eV x) at hx
    simp only [endomorphismRepresentation, mapOfIdempotent_apply,
      LinearMap.comp_apply, LinearMap.add_apply, LinearMap.smul_apply,
      LinearMap.sub_apply, Module.End.one_apply]
    rw [hx]
    simp only [map_add, map_smul, map_sub]

@[simp]
theorem ofSelectorIntertwines_map
    (Theta : V →ₗ[R] W)
    (hTheta : eW.comp Theta = Theta.comp eV) :
    (ofSelectorIntertwines (heV := heV) (heW := heW)
      Theta hTheta).map = Theta :=
  rfl

/-- The full universal-algebra intertwining law is exactly the one square for
the distinguished idempotents. -/
theorem intertwines_iff_selector
    (Theta : V →ₗ[R] W) :
    (∀ z : UniversalIdempotentAlgebra R,
        (endomorphismRepresentation eW heW z).comp Theta =
          Theta.comp (endomorphismRepresentation eV heV z)) ↔
      eW.comp Theta = Theta.comp eV := by
  constructor
  · intro h
    simpa only [endomorphismRepresentation, mapOfIdempotent_selector] using
      h (selector (R := R))
  · intro h
    exact (ofSelectorIntertwines
      (heV := heV) (heW := heW) Theta h).intertwines

end RepresentationMorphism

end UniversalIdempotentAlgebra

end

end HodgeConjecture
