import HodgeConjecture.Boundary.GaloisProjectorExtension
import HodgeConjecture.LinearAlgebra.MarkedAugmentedAlgebra
import HodgeConjecture.Realization.Chow.IdempotentRepresentation
import HodgeConjecture.Realization.Chow.TateGraphProjector

/-!
# Realization of a marked augmented algebra

This file carries the rank-one projector of an abstract marked augmented
commutative algebra into a rational Tate block.  It is independent of a
particular sheet presentation: a residual linear map sends the canonical
class `q - 1` to its generated cohomology class, and the induced product map
intertwines multiplication by `q` with the corresponding class graph
projector.

`MarkedSelectorActionComparison` records the substantive comparison square
for an idempotent in a possibly noncommutative compactified correspondence
algebra.  The square is equivalently exposed as a morphism of representations
of the universal one-idempotent algebra `ℚ × ℚ`.  Evaluating it at the
marked unit recovers the generated class without a surjectivity assumption.
Surjectivity is used only to identify the entire cohomological action with
the graph projector, at which point the target is also stated as an equality
of algebra-homomorphism composites.

No residual realization, compactified extension, or comparison square is
constructed here.
-/

set_option autoImplicit false

namespace HodgeConjecture

noncomputable section

universe u v w z

namespace MarkedAugmentedAlgebra

variable {A : Type u} [CommRing A] [Algebra ℚ A]
variable (M : MarkedAugmentedAlgebra ℚ A)
variable {H : Type v} [AddCommGroup H] [Module ℚ H]

/-- The graph operator of a marked augmented algebra is the canonical class
graph projector of its residual class. -/
theorem graphOperator_eq_classGraphProjector :
    M.graphOperator =
      ClassGraphProjector.operator M.residualClass :=
  rfl

/-- Multiplication by the selector, expressed in constant-unit coordinates,
is an idempotent endomorphism. -/
theorem decomposedSelector_isIdempotent :
    IsIdempotentElem
      (M.decomposition.conj M.multiplication) := by
  rw [M.decomposition_conj_multiplication]
  exact ClassGraphProjector.operator_isIdempotent M.residualClass

/-- The canonical representation of the universal one-idempotent algebra on
the marked source in constant-unit coordinates.  Its selector acts by
multiplication with the marked algebra selector. -/
noncomputable def selectorRepresentation :
    UniversalIdempotentAlgebra ℚ →ₐ[ℚ]
      Module.End ℚ (ℚ × M.Residual) :=
  UniversalIdempotentAlgebra.endomorphismRepresentation
    (M.decomposition.conj M.multiplication)
    M.decomposedSelector_isIdempotent

@[simp]
theorem selectorRepresentation_selector :
    M.selectorRepresentation
        (UniversalIdempotentAlgebra.selector (R := ℚ)) =
      M.decomposition.conj M.multiplication :=
  UniversalIdempotentAlgebra.mapOfIdempotent_selector
    (M.decomposition.conj M.multiplication)
    M.decomposedSelector_isIdempotent

/-- The cohomology class generated by a realization of the residual module. -/
def generatedClass (theta : M.Residual →ₗ[ℚ] H) : H :=
  theta M.residualClass

/-- Apply a residual realization to the residual factor while preserving the
marked rational line. -/
def productRealization (theta : M.Residual →ₗ[ℚ] H) :
    ℚ × M.Residual →ₗ[ℚ] ℚ × H :=
  (LinearMap.id : ℚ →ₗ[ℚ] ℚ).prodMap theta

@[simp]
theorem productRealization_apply
    (theta : M.Residual →ₗ[ℚ] H)
    (t : ℚ) (x : M.Residual) :
    M.productRealization theta (t, x) = (t, theta x) :=
  rfl

/-- A surjective residual realization remains surjective after adjoining the
marked rational line. -/
theorem productRealization_surjective
    {theta : M.Residual →ₗ[ℚ] H}
    (htheta : Function.Surjective theta) :
    Function.Surjective (M.productRealization theta) := by
  rintro ⟨t, y⟩
  obtain ⟨x, rfl⟩ := htheta y
  exact ⟨(t, x), rfl⟩

/-- Class graph projectors are natural under maps of residual factors. -/
theorem productRealization_intertwines_graphOperator
    (theta : M.Residual →ₗ[ℚ] H) :
    (M.productRealization theta).comp M.graphOperator =
      (ClassGraphProjector.operator (M.generatedClass theta)).comp
        (M.productRealization theta) := by
  apply LinearMap.ext
  rintro ⟨t, x⟩
  simp [generatedClass]

/-- Multiplication by the marked selector maps to the graph projector of the
class generated by the residual realization. -/
theorem productRealization_intertwines_selectorMultiplication
    (theta : M.Residual →ₗ[ℚ] H) :
    (M.productRealization theta).comp
        (M.decomposition.conj M.multiplication) =
      (ClassGraphProjector.operator (M.generatedClass theta)).comp
        (M.productRealization theta) := by
  rw [M.decomposition_conj_multiplication]
  exact M.productRealization_intertwines_graphOperator theta

end MarkedAugmentedAlgebra

variable {A : Type u} [CommRing A] [Algebra ℚ A]
variable {Gamma : Type w} [Ring Gamma] [Algebra ℚ Gamma]
variable {H : Type v} [AddCommGroup H] [Module ℚ H]
variable {M : MarkedAugmentedAlgebra ℚ A}
variable {rho : RationalCorrespondenceAction Gamma (ℚ × H)}
variable
  {E : AlgebraProjectorExtension A Gamma M.selector}
variable {x : E.Extension}

/--
The realization square for a compactified extension of the selector in an
abstract marked augmented algebra.

The generated target class is deliberately an output of
`residualRealization`; no external class or equality with a prescribed class
is included in this structure.
-/
structure MarkedSelectorActionComparison
    (M : MarkedAugmentedAlgebra ℚ A)
    (rho : RationalCorrespondenceAction Gamma (ℚ × H))
    (E : AlgebraProjectorExtension A Gamma M.selector)
    (x : E.Extension) where
  residualRealization : M.Residual →ₗ[ℚ] H
  action_intertwines :
    (rho.action (E.projector x)).comp
        (M.productRealization residualRealization) =
      (M.productRealization residualRealization).comp
        (M.decomposition.conj M.multiplication)

namespace MarkedSelectorActionComparison

/-- The compactified projector remains idempotent after applying the
cohomological correspondence action. -/
theorem compactifiedAction_isIdempotent
    (_B : MarkedSelectorActionComparison M rho E x) :
    IsIdempotentElem (rho.action (E.projector x)) :=
  (E.projector_isIdempotent x).map rho.action

/-- The comparison square as an honest morphism of representations of the
universal one-idempotent algebra.  This is equivalent to the stored selector
square, rather than an additional hypothesis. -/
noncomputable def toIdempotentRepresentationMorphism
    (B : MarkedSelectorActionComparison M rho E x) :
    UniversalIdempotentAlgebra.RepresentationMorphism
      (M.decomposition.conj M.multiplication)
      M.decomposedSelector_isIdempotent
      (rho.action (E.projector x))
      B.compactifiedAction_isIdempotent :=
  UniversalIdempotentAlgebra.RepresentationMorphism.ofSelectorIntertwines
    (M.productRealization B.residualRealization)
    B.action_intertwines

@[simp]
theorem toIdempotentRepresentationMorphism_map
    (B : MarkedSelectorActionComparison M rho E x) :
    B.toIdempotentRepresentationMorphism.map =
      M.productRealization B.residualRealization :=
  rfl

/-- The full universal-algebra intertwining law represented by the one
selector square in the comparison package. -/
theorem universal_intertwines
    (B : MarkedSelectorActionComparison M rho E x)
    (z : UniversalIdempotentAlgebra ℚ) :
    (UniversalIdempotentAlgebra.endomorphismRepresentation
        (rho.action (E.projector x))
        B.compactifiedAction_isIdempotent z).comp
        (M.productRealization B.residualRealization) =
      (M.productRealization B.residualRealization).comp
        (M.selectorRepresentation z) :=
  B.toIdempotentRepresentationMorphism.intertwines z

/-- Evaluating the comparison square at the marked unit detects the generated
lower-left class.  No surjectivity is required. -/
theorem lowerLeftClass_action_eq_generatedClass
    (B : MarkedSelectorActionComparison M rho E x) :
    ClassGraphProjector.lowerLeftClass
        (rho.action (E.projector x)) =
      M.generatedClass B.residualRealization := by
  have hSquare :=
    LinearMap.congr_fun B.action_intertwines
      ((1, 0) : ℚ × M.Residual)
  rw [M.decomposition_conj_multiplication] at hSquare
  have hSecond := congrArg Prod.snd hSquare
  simpa [ClassGraphProjector.lowerLeftClass,
    LinearMap.comp_apply, MarkedAugmentedAlgebra.generatedClass] using hSecond

/-- Surjective cancellation identifies the whole compactified selector action
with the graph projector of the generated class. -/
theorem realizes
    (B : MarkedSelectorActionComparison M rho E x)
    (hSurjective : Function.Surjective B.residualRealization) :
    rho.action (E.projector x) =
      ClassGraphProjector.operator
        (M.generatedClass B.residualRealization) := by
  apply LinearMap.ext
  intro y
  obtain ⟨z, rfl⟩ :=
    M.productRealization_surjective hSurjective y
  calc
    rho.action (E.projector x)
          (M.productRealization B.residualRealization z) =
        M.productRealization B.residualRealization
          ((M.decomposition.conj M.multiplication) z) :=
      LinearMap.congr_fun B.action_intertwines z
    _ =
        ClassGraphProjector.operator
            (M.generatedClass B.residualRealization)
          (M.productRealization B.residualRealization z) :=
      LinearMap.congr_fun
        (M.productRealization_intertwines_selectorMultiplication
          B.residualRealization) z

/-- Under surjectivity, a compactified selector is an algebraic lift of the
graph projector of its generated class. -/
def toAlgebraicProjectorLift
    (B : MarkedSelectorActionComparison M rho E x)
    (hSurjective : Function.Surjective B.residualRealization) :
    AlgebraicProjectorLift rho
      (ClassGraphProjector.operator
        (M.generatedClass B.residualRealization)) :=
  E.projectorLiftOfRealizes x rho
    (ClassGraphProjector.operator
      (M.generatedClass B.residualRealization))
    (B.realizes hSurjective)

/-- Palomar-style Hodge target: after surjective cancellation, the
cohomological action composed with the compactified one-idempotent map equals
the canonical one-idempotent presentation of the generated class graph. -/
theorem action_comp_compactifiedIdempotentMap_eq_classGraph
    (B : MarkedSelectorActionComparison M rho E x)
    (hSurjective : Function.Surjective B.residualRealization) :
    rho.action.comp (E.compactifiedIdempotentMap x) =
      UniversalIdempotentAlgebra.mapOfIdempotent
        (ClassGraphProjector.operator
          (M.generatedClass B.residualRealization))
        (ClassGraphProjector.operator_isIdempotent
          (M.generatedClass B.residualRealization)) := by
  unfold AlgebraProjectorExtension.compactifiedIdempotentMap
  rw [UniversalIdempotentAlgebra.comp_mapOfIdempotent]
  simp only [B.realizes hSurjective]

end MarkedSelectorActionComparison

/-!
## Optional stronger presentations in a generic correspondence algebra

In some geometric settings the entire commutative source may map
multiplicatively into a generally
noncommutative generic correspondence algebra.  Its image is a commutative
subalgebra, while the ambient algebra need not be commutative.  Requiring an
algebra homomorphism here keeps idempotence transport honest.

This optional interface is not required by the active Galois route and must
not be instantiated by the merely linear coset map
`gH \mapsto [g] e_H`: pointwise sheet multiplication and group-algebra
convolution are different products.  A geometric application must construct
the multiplicative presentation it actually uses (for example through a
regular-action or component-correspondence algebra).
-/

variable {B : Type z} [Ring B] [Algebra ℚ B]

/--
A multiplicative presentation of the marked selector in a generic rational
correspondence algebra.

The target may be noncommutative; only the image of the commutative source is
forced to commute.  Different class-dependent presentations may have
different images, so this does not impose a single commutative correspondence
algebra on every Hodge-class projector.
-/
structure MarkedSelectorAlgebraPresentation
    (M : MarkedAugmentedAlgebra ℚ A)
    (B : Type z) [Ring B] [Algebra ℚ B] where
  toAlgHom : A →ₐ[ℚ] B

namespace MarkedSelectorAlgebraPresentation

variable
  (P : MarkedSelectorAlgebraPresentation M B)

/-- The image of the marked selector in the generic correspondence algebra. -/
abbrev genericProjector : B :=
  P.toAlgHom M.selector

/-- Multiplicative presentation carries the source selector's idempotence to
the generic correspondence algebra. -/
theorem genericProjector_isIdempotent :
    IsIdempotentElem P.genericProjector :=
  M.selector_isIdempotent.map P.toAlgHom

/-- The identity presentation when the generic correspondence algebra is the
marked commutative source itself. -/
def identity
    (M : MarkedAugmentedAlgebra ℚ A) :
    MarkedSelectorAlgebraPresentation M A where
  toAlgHom := AlgHom.id ℚ A

@[simp]
theorem identity_toAlgHom
    (M : MarkedAugmentedAlgebra ℚ A) :
    (identity M).toAlgHom = AlgHom.id ℚ A :=
  rfl

@[simp]
theorem identity_genericProjector
    (M : MarkedAugmentedAlgebra ℚ A) :
    (identity M).genericProjector = M.selector :=
  rfl

/-- The canonical multiplicative presentation by the regular action of the
commutative source on its underlying module. -/
def regularAction
    (M : MarkedAugmentedAlgebra ℚ A) :
    MarkedSelectorAlgebraPresentation M (Module.End ℚ A) where
  toAlgHom := M.regularAction

@[simp]
theorem regularAction_genericProjector
    (M : MarkedAugmentedAlgebra ℚ A) :
    (regularAction M).genericProjector = M.multiplication :=
  M.regularAction_selector

end MarkedSelectorAlgebraPresentation

variable
  {P : MarkedSelectorAlgebraPresentation M B}
variable
  {F : AlgebraProjectorExtension B Gamma P.genericProjector}
variable {y : F.Extension}

/--
The action comparison for a commutative marked source presented
multiplicatively in
an arbitrary generic correspondence algebra.

The extension data say that the compactified idempotent restricts to the
presented image of the source selector.  The final square remains the genuine
geometric realization input; it is not implied by the linear presentation.
-/
structure PresentedMarkedSelectorActionComparison
    (M : MarkedAugmentedAlgebra ℚ A)
    (P : MarkedSelectorAlgebraPresentation M B)
    (rho : RationalCorrespondenceAction Gamma (ℚ × H))
    (F : AlgebraProjectorExtension B Gamma P.genericProjector)
    (y : F.Extension) where
  residualRealization : M.Residual →ₗ[ℚ] H
  action_intertwines :
    (rho.action (F.projector y)).comp
        (M.productRealization residualRealization) =
      (M.productRealization residualRealization).comp
        (M.decomposition.conj M.multiplication)

namespace MarkedSelectorActionComparison

/-- Regard an action comparison whose generic algebra is the marked source
itself as a comparison through the identity multiplicative presentation. -/
def toPresentedIdentity
    (C : MarkedSelectorActionComparison M rho E x) :
    PresentedMarkedSelectorActionComparison M
      (MarkedSelectorAlgebraPresentation.identity M) rho E x where
  residualRealization := C.residualRealization
  action_intertwines := C.action_intertwines

@[simp]
theorem toPresentedIdentity_residualRealization
    (C : MarkedSelectorActionComparison M rho E x) :
    C.toPresentedIdentity.residualRealization = C.residualRealization :=
  rfl

end MarkedSelectorActionComparison

namespace PresentedMarkedSelectorActionComparison

/-- The chosen compactified projector restricts to the multiplicative image of the
marked commutative selector. -/
theorem projector_restricts_to_presentedSelector
    (_C : PresentedMarkedSelectorActionComparison M P rho F y) :
    F.restriction (F.projector y) =
      P.toAlgHom M.selector :=
  F.projector_restricts y

/-- Evaluating the comparison square at the marked unit identifies the
lower-left class with the class generated by the residual realization. -/
theorem lowerLeftClass_action_eq_generatedClass
    (C : PresentedMarkedSelectorActionComparison M P rho F y) :
    ClassGraphProjector.lowerLeftClass
        (rho.action (F.projector y)) =
      M.generatedClass C.residualRealization := by
  have hSquare :=
    LinearMap.congr_fun C.action_intertwines
      ((1, 0) : ℚ × M.Residual)
  rw [M.decomposition_conj_multiplication] at hSquare
  have hSecond := congrArg Prod.snd hSquare
  simpa [ClassGraphProjector.lowerLeftClass,
    LinearMap.comp_apply, MarkedAugmentedAlgebra.generatedClass] using hSecond

/-- Surjectivity of the residual realization upgrades lower-left detection
to equality with the entire canonical graph projector. -/
theorem realizes
    (C : PresentedMarkedSelectorActionComparison M P rho F y)
    (hSurjective : Function.Surjective C.residualRealization) :
    rho.action (F.projector y) =
      ClassGraphProjector.operator
        (M.generatedClass C.residualRealization) := by
  apply LinearMap.ext
  intro h
  obtain ⟨a, rfl⟩ :=
    M.productRealization_surjective hSurjective h
  calc
    rho.action (F.projector y)
          (M.productRealization C.residualRealization a) =
        M.productRealization C.residualRealization
          ((M.decomposition.conj M.multiplication) a) :=
      LinearMap.congr_fun C.action_intertwines a
    _ =
        ClassGraphProjector.operator
            (M.generatedClass C.residualRealization)
          (M.productRealization C.residualRealization a) :=
      LinearMap.congr_fun
        (M.productRealization_intertwines_selectorMultiplication
          C.residualRealization) a

/-- The presented compactified selector is an algebraic lift of the generated
graph projector whenever the residual realization is surjective. -/
def toAlgebraicProjectorLift
    (C : PresentedMarkedSelectorActionComparison M P rho F y)
    (hSurjective : Function.Surjective C.residualRealization) :
    AlgebraicProjectorLift rho
      (ClassGraphProjector.operator
        (M.generatedClass C.residualRealization)) :=
  F.projectorLiftOfRealizes y rho
    (ClassGraphProjector.operator
      (M.generatedClass C.residualRealization))
    (C.realizes hSurjective)

end PresentedMarkedSelectorActionComparison

end

end HodgeConjecture
