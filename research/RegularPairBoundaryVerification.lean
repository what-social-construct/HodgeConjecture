import HodgeConjecture.Boundary.Normalization.RegularPairBoundary
import Lean.Util.CollectAxioms

/-!
Focused SP68 regressions. Run with
`lake env lean research/RegularPairBoundaryVerification.lean`.
The prescribed-element denominator preserves the existing pole construction.
Quotient regularity supplies cancellation without normality or trace hypotheses;
the unit-ideal case is permitted. Geometric regular-pair witnesses remain explicit.
All three new public declarations have an enforced standard-axiom allowlist.
-/

open AlgebraicGeometry CategoryTheory HodgeConjecture
open HodgeConjecture.NormalizationInertia

set_option autoImplicit false
set_option maxHeartbeats 800000
set_option synthInstance.maxHeartbeats 100000

noncomputable section

section Algebra

variable {T : Type*} [CommRing T] [IsDomain T] [IsNoetherianRing T]

-- Any nonzero prescribed denominator works locally; ideal membership is not needed here.
example (J : Ideal T) (p : PrimeSpectrum T)
    (hp : p.asIdeal.primeHeight = 1) (hJp : J ≤ p.asIdeal)
    (f : T) (hf0 : f ≠ 0) :
    ∃ (t : T) (n : ℕ), t ∉ p.asIdeal ∧
      ∀ x ∈ J ^ n, t * x ∈ Ideal.span {f} := by
  fail_if_success have _ : IsIntegrallyClosed T := inferInstance
  exact exists_heightOne_boundary_denominator_of_ne_zero J p hp hJp f hf0

-- The original existential witness remains available with its unchanged interface.
example (J : Ideal T) (hJ : J ≠ ⊥) (p : PrimeSpectrum T)
    (hp : p.asIdeal.primeHeight = 1) (hJp : J ≤ p.asIdeal) :
    ∃ (f t : T) (n : ℕ), f ∈ J ∧ f ≠ 0 ∧ t ∉ p.asIdeal ∧
      ∀ x ∈ J ^ n, t * x ∈ Ideal.span {f} :=
  exists_heightOne_boundary_denominator J hJ p hp hJp

example (J : Ideal T) (f g : T) (hf : f ∈ J) (hg : g ∈ J) (hf0 : f ≠ 0)
    (hRegular : IsSMulRegular (T ⧸ Ideal.span {f}) g)
    (p : PrimeSpectrum T) (hp : p.asIdeal.primeHeight = 1) :
    ¬ J ≤ p.asIdeal := by
  fail_if_success have _ : IsIntegrallyClosed T := inferInstance
  exact not_le_heightOne_of_regularPair J f g hf hg hf0 hRegular p hp

-- The generic statement also applies to the ideal generated by the pair itself.
example (f g : T) (hf0 : f ≠ 0)
    (hRegular : IsSMulRegular (T ⧸ Ideal.span {f}) g)
    (p : PrimeSpectrum T) (hp : p.asIdeal.primeHeight = 1) :
    ¬ Ideal.span ({f, g} : Set T) ≤ p.asIdeal := by
  apply not_le_heightOne_of_regularPair _ f g _ _ hf0 hRegular p hp
  · exact Ideal.subset_span (by simp)
  · exact Ideal.subset_span (by simp)

-- Cancellation works for every power, including the zero power.
example (f g t : T) (n : ℕ)
    (hRegular : IsSMulRegular (T ⧸ Ideal.span {f}) g)
    (h : t * g ^ n ∈ Ideal.span {f}) : t ∈ Ideal.span {f} := by
  apply mem_of_isSMulRegular_quotient_of_smul_mem (hRegular.pow n)
  simpa only [smul_eq_mul, mul_comm] using h

-- This special case needs neither nonvanishing nor any regularity hypothesis.
example (f g t : T) (h : t * g ^ 0 ∈ Ideal.span {f}) :
    t ∈ Ideal.span {f} := by
  simpa using h

-- Reusing the first element as the second can be regular only when it is a unit.
example (f : T) (hRegular : IsSMulRegular (T ⧸ Ideal.span {f}) f) :
    IsUnit f := by
  have hOne : (1 : T) ∈ Ideal.span {f} :=
    mem_of_isSMulRegular_quotient_of_smul_mem hRegular
      (by simpa only [smul_eq_mul, mul_one] using
        (Ideal.subset_span (Set.mem_singleton f) : f ∈ Ideal.span {f}))
  exact (Ideal.span_singleton_eq_top).mp
    (Ideal.eq_top_of_isUnit_mem _ hOne isUnit_one)

-- This is a regular-pair criterion, not a full regular-sequence definition:
-- the final quotient may be zero, so the unit ideal is intentionally allowed.
example (p : PrimeSpectrum T) (hp : p.asIdeal.primeHeight = 1) :
    ¬ (⊤ : Ideal T) ≤ p.asIdeal := by
  exact not_le_heightOne_of_regularPair ⊤ 1 1 (by simp) (by simp)
    one_ne_zero (IsSMulRegular.one _) p hp

-- A concrete ring specialization checks that no fraction-field data are required.
example (p : PrimeSpectrum ℤ) (hp : p.asIdeal.primeHeight = 1) :
    ¬ (⊤ : Ideal ℤ) ≤ p.asIdeal :=
  not_le_heightOne_of_regularPair ⊤ 1 1 (by simp) (by simp)
    one_ne_zero (IsSMulRegular.one _) p hp

end Algebra

section Boundary

universe u

variable {B K L N : Type u}
variable [CommRing B] [Field K] [Field L] [Field N]
variable [Algebra B K]
variable [Algebra K L] [Algebra K N]
variable [Algebra B L] [Algebra B N]
variable [IsScalarTower B K L] [IsScalarTower B K N]
variable {U : Scheme.{u}}
variable {j : U ⟶ intermediateNormalization (B := B) (L := L)}
variable (C : NormalizedCover (B := B) (K := K) (L := L) (N := N) U j)
variable [IsNoetherianRing B]

local notation "T₀" => NormalClosureNormalizationRing (B := B) (N := N)

-- Witness existence is supplied in the original two summands, not in a new ideal.
example (hPairs : ∀ (I : Subgroup C.GaloisGroup), I ≠ ⊥ →
      ∃ f g : T₀, f ∈ fixedLocusIdeal I ∧ f ≠ 0 ∧
        g ∈ movingBoundaryIdeal (pulledBackConjugateBoundaryIdeal C) I ∧
        IsSMulRegular (T₀ ⧸ Ideal.span {f}) g) :
    ConjugateBoundarySeparation C := by
  fail_if_success have _ : IsFractionRing B K := inferInstance
  fail_if_success have _ : PerfectField K := inferInstance
  fail_if_success have _ : IsIntegrallyClosed B := inferInstance
  exact conjugateBoundarySeparation_of_fixedMoving_regularPairs C hPairs

end Boundary

end

open Lean Elab Command in
run_cmd do
  let env ← getEnv
  let permitted := [`propext, `Classical.choice, `Quot.sound]
  for declaration in [
      `HodgeConjecture.NormalizationInertia.exists_heightOne_boundary_denominator_of_ne_zero,
      `HodgeConjecture.NormalizationInertia.not_le_heightOne_of_regularPair,
      `HodgeConjecture.NormalizationInertia.conjugateBoundarySeparation_of_fixedMoving_regularPairs] do
    unless (env.find? declaration).isSome do
      throwError "Missing declaration {declaration}"
    let (_, state) := ((CollectAxioms.collect declaration).run env).run {}
    for axiomName in state.axioms do
      unless permitted.contains axiomName do
        throwError "Unexpected axiom {axiomName} in {declaration}"
    logInfo m!"PASS standard-axiom boundary: {declaration}; {state.axioms.toList}"
